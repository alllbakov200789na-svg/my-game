local S={}
function S:Init(ctx)
 self.C=ctx; self.Actors={}; self.ByPlayer={}; self.Connections={}
 local desc=Instance.new(&quot;HumanoidDescription&quot;)
 desc.HeadColor=Color3.fromRGB(242,205,183); desc.LeftArmColor=desc.HeadColor; desc.RightArmColor=desc.HeadColor
 desc.TorsoColor=Color3.fromRGB(25,23,44); desc.LeftLegColor=desc.TorsoColor; desc.RightLegColor=desc.TorsoColor
 local ok,rig=pcall(function() return Players:CreateHumanoidModelFromDescriptionAsync(desc,Enum.HumanoidRigType.R15) end)
 desc:Destroy()
 assert(ok and rig,&quot;R15 template creation failed: &quot;..tostring(rig))
 self.Template=rig; rig.Name=&quot;ProceduralR15&quot;; rig.Parent=game:GetService(&quot;ServerStorage&quot;).ServerAssets
 local h=ctx.U.humanoid(rig); h.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None
end
function S:Attach(model,name,size,offset,color,shape)
 local head=model:FindFirstChild(&quot;Head&quot;); if not head then return end
 local p=Instance.new(&quot;Part&quot;); p.Name=name; p.Size=size; p.Color=color; p.Material=Enum.Material.SmoothPlastic
 p.CanCollide=false; p.CanTouch=false; p.CanQuery=false; p.Massless=true
 if shape then p.Shape=shape end
 p.CFrame=head.CFrame*offset; p.Parent=model
 local w=Instance.new(&quot;WeldConstraint&quot;); w.Part0=head; w.Part1=p; w.Parent=p
end
function S:Style(model,role,team)
 local C=self.C; local d=C.Characters[role]; local tint=C.U.color(d.VFXProfile)
 for _,o in ipairs(model:GetDescendants()) do
  if o:IsA(&quot;Accessory&quot;) or o:IsA(&quot;Shirt&quot;) or o:IsA(&quot;Pants&quot;) or o:IsA(&quot;ShirtGraphic&quot;) then o:Destroy()
  elseif o:IsA(&quot;BasePart&quot;) and o.Name~=&quot;HumanoidRootPart&quot; then
   o.Material=Enum.Material.SmoothPlastic
   if o.Name~=&quot;Head&quot; and not string.find(o.Name,&quot;Hand&quot;) then o.Color=Color3.fromRGB(25,23,43) end
  end
 end
 self:Attach(model,&quot;Collar&quot;,Vector3.new(1.6,0.6,1.15),CFrame.new(0,-0.65,0),tint)
 self:Attach(model,&quot;Hair&quot;,Vector3.new(1.3,0.55,1.1),CFrame.new(0,0.55,0.04),role==&quot;Gojo&quot; and Color3.fromRGB(235,247,255) or Color3.fromRGB(95,40,75))
 for i=-2,2 do self:Attach(model,&quot;HairSpike&quot;,Vector3.new(0.28,0.65,0.45),CFrame.new(i*0.24,0.75,-0.05)*CFrame.Angles(0,0,i*0.18),role==&quot;Gojo&quot; and Color3.fromRGB(235,247,255) or Color3.fromRGB(95,40,75)) end
 if role==&quot;Gojo&quot; then self:Attach(model,&quot;Blindfold&quot;,Vector3.new(1.25,0.25,0.16),CFrame.new(0,0.12,-0.55),Color3.fromRGB(15,18,32))
 elseif role==&quot;Sukuna&quot; or role==&quot;Curse&quot; then
  for _,x in ipairs({-0.32,0.32}) do self:Attach(model,&quot;CurseMark&quot;,Vector3.new(0.1,0.48,0.08),CFrame.new(x,0,-0.56)*CFrame.Angles(0,0,x),tint) end
 end
 local hi=Instance.new(&quot;Highlight&quot;); hi.Name=&quot;TeamOutline&quot;; hi.Adornee=model
 hi.FillTransparency=1; hi.OutlineTransparency=0.45; hi.OutlineColor=team==&quot;Curses&quot; and Color3.fromRGB(255,80,100) or Color3.fromRGB(90,185,255)
 hi.DepthMode=Enum.HighlightDepthMode.Occluded; hi.Parent=model
end
function S:Spawn(p,role,team,abilities,cf,participant)
 local C=self.C
 local old=self.ByPlayer[p]
 if old then old.Alive=false; self.Actors[old.Model]=nil; if old.Connection then old.Connection:Disconnect() end end
 if p.Character then p.Character:Destroy() end
 local model=self.Template:Clone(); model.Name=p.Name
 local d=C.Characters[role]; local h=C.U.humanoid(model); h.MaxHealth=d.BaseHealth; h.Health=d.BaseHealth; h.WalkSpeed=d.WalkSpeed
 h.BreakJointsOnDeath=false; h.DisplayName=p.DisplayName; h.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.Viewer
 model:SetAttribute(&quot;Role&quot;,role); model:SetAttribute(&quot;Faction&quot;,team); model:SetAttribute(&quot;Participant&quot;,participant)
 self:Style(model,role,team)
 model:SetAttribute(&quot;Weapon&quot;,table.find(abilities,&quot;Katana&quot;) and &quot;Katana&quot; or &quot;Fists&quot;)
 if table.find(abilities,&quot;Katana&quot;) then
  local hand=model:FindFirstChild(&quot;RightHand&quot;)
  if hand then
   local blade=Instance.new(&quot;Part&quot;); blade.Name=&quot;CursedKatana&quot;; blade.Size=Vector3.new(0.16,3.7,0.35); blade.Color=Color3.fromRGB(180,170,255); blade.Material=Enum.Material.Metal
   blade.CanCollide=false; blade.CanQuery=false; blade.CanTouch=false; blade.Massless=true; blade.CFrame=hand.CFrame*CFrame.new(0,-1.6,-0.5); blade.Parent=model
   local weld=Instance.new(&quot;WeldConstraint&quot;); weld.Part0=hand; weld.Part1=blade; weld.Parent=blade
  end
 end
 model.Parent=workspace; model:PivotTo(cf); p.Character=model
 local root=C.U.root(model); if root then root:SetNetworkOwner(p) end
 local a={Model=model,Player=p,Role=role,Team=team,Definition=d,Alive=true,Participant=participant,Energy=d.Energy,
 Stamina=d.Stamina,Ultimate=0,Abilities=abilities,Cooldowns={},Actions=0,ActiveSeconds=0,Damage=0,Healed=0,
 UsedAbilities={},Eliminations=0,MotionGrace=os.clock()+3,SpawnAt=os.clock(),ShieldUntil=0,StunUntil=0}
 self.Actors[model]=a; self.ByPlayer[p]=a; C.AntiExploitService.Motion[p]=nil; p:SetAttribute(&quot;Spectator&quot;,not participant)
 a.Connection=h.Died:Connect(function() self:Die(a) end)
 self:Cosmetic(p)
 local profile=C.PlayerDataService:Get(p)
 if root and profile and profile.Entitlements.Spawn then C.Remotes.Effect:FireAllClients(&quot;Spawn&quot;,root.Position,{200,150,255},14,model) end
 return a
end
function S:Die(a)
 if not a.Alive then return end
 a.Alive=false; a.Sprinting=false; a.Model:SetAttribute(&quot;Dead&quot;,true)
 if a.Player then a.Player:SetAttribute(&quot;Spectator&quot;,true) end
 local killer=a.LastAttacker
 if killer and killer~=a and (os.clock()-(a.LastHitAt or 0))&lt;8 then
  killer.Eliminations=(killer.Eliminations or 0)+1
  if killer.Player then
   self.C.QuestService:Progress(killer.Player,&quot;Curse&quot;,a.Team==&quot;Curses&quot; and 1 or 0)
   self.C.PlayerDataService:Mutate(killer.Player,function(d) d.Eliminations=d.Eliminations+1 end)
   local d=self.C.PlayerDataService:Get(killer.Player)
   if d and d.EquippedCosmetics==&quot;Eclipse&quot; then self.C.Remotes.Effect:FireAllClients(&quot;Finisher&quot;,self.C.U.root(a.Model).Position,{240,225,255},9) end
  end
 end
end
function S:Lobby(p)
 if not p.Parent then return end
 return self:Spawn(p,&quot;Sorcerer&quot;,&quot;Sorcerers&quot;,{},CFrame.new(0,7,360),false)
end
function S:Cosmetic(p)
 local d=self.C.PlayerDataService:Get(p); local a=self.ByPlayer[p]
 if not d or not a then return end
 local old=a.Model:FindFirstChild(&quot;Cosmetic&quot;); if old then old:Destroy() end
 local c=self.C.Config.Cosmetics[d.EquippedCosmetics]; local root=self.C.U.root(a.Model)
 if not c or not root then return end
 local holder=Instance.new(&quot;Folder&quot;); holder.Name=&quot;Cosmetic&quot;; holder.Parent=a.Model
 local at=Instance.new(&quot;Attachment&quot;); at.Name=&quot;AuraAttachment&quot;; at.Parent=root
 local previous=root:FindFirstChild(&quot;PreviousAura&quot;); if previous then previous:Destroy() end
 at.Name=&quot;PreviousAura&quot;
 local emitter=Instance.new(&quot;ParticleEmitter&quot;); emitter.Color=ColorSequence.new(self.C.U.color(c.Color))
 emitter.Rate=9; emitter.Lifetime=NumberRange.new(0.5,1); emitter.Speed=NumberRange.new(0.5,2)
 emitter.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,0.2),NumberSequenceKeypoint.new(1,0)})
 emitter.Transparency=NumberSequence.new(0.2,1); emitter.LightEmission=0.8; emitter.Parent=at
 holder.Destroying:Connect(function() if at.Parent then at:Destroy() end end)
end
function S:Transform(p)
 local a=self.ByPlayer[p]; if not a or not a.Alive then return false end
 local pos=a.Model:GetPivot()
 local b=self:Spawn(p,&quot;Sukuna&quot;,&quot;Curses&quot;,table.clone(self.C.Characters.Sukuna.AbilitySet),pos,true)
 for _,key in ipairs({&quot;Actions&quot;,&quot;ActiveSeconds&quot;,&quot;Damage&quot;,&quot;Healed&quot;,&quot;UsedAbilities&quot;,&quot;Eliminations&quot;,&quot;Objectives&quot;}) do b[key]=a[key] end
 self.C.AntiExploitService.Motion[p]=nil
 return true
end
function S:Step(dt)
 local C=self.C
 for _,a in pairs(self.Actors) do
  if a.Alive then
   local h=C.U.humanoid(a.Model); local root=C.U.root(a.Model)
   if h and root then
    if root.Position.Y&lt;C.Config.KillY then h.Health=0 end
    if a.Participant and C.RoundService:IsCombat() then
     a.Energy=math.min(100,a.Energy+C.Config.EnergyRegen*dt)
     local moving=h.MoveDirection.Magnitude&gt;0.1
     if moving then a.ActiveSeconds=a.ActiveSeconds+dt end
     if a.Sprinting and moving and a.Stamina&gt;0 and os.clock()&gt;a.StunUntil then
      a.Stamina=math.max(0,a.Stamina-C.Config.SprintDrain*dt); h.WalkSpeed=a.Definition.SprintSpeed
     else a.Stamina=math.min(100,a.Stamina+C.Config.StaminaRegen*dt); h.WalkSpeed=a.Definition.WalkSpeed end
     if os.clock()&lt;a.StunUntil then h.WalkSpeed=0; h.Jump=false end
     C.AntiExploitService:Step(a,dt)
    end
   end
  end
 end
end
function S:Remove(p)
 local a=self.ByPlayer[p]; if a then a.Alive=false; if a.Connection then a.Connection:Disconnect() end; self.Actors[a.Model]=nil end
 self.ByPlayer[p]=nil
end
return S
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2155"><Properties><string name="Name">CombatService</string><ProtectedString name="Source">local S={}
function S:Init(ctx) self.C=ctx end
function S:Ray(origin,direction,exclude)
 local rp=RaycastParams.new(); rp.FilterType=Enum.RaycastFilterType.Exclude; rp.FilterDescendantsInstances=exclude or {}
 rp.IgnoreWater=true; return workspace:Raycast(origin,direction,rp)
end
function S:Visible(origin,target,exclude)
 local root=self.C.U.root(target.Model); if not root then return false end
 local hit=self:Ray(origin,root.Position-origin,exclude)
 return not hit or hit.Instance:IsDescendantOf(target.Model)
end
function S:Area(a,center,radius,damage,knock,stun)
 local C=self.C; local hits=0
 for _,b in pairs(C.CharacterService.Actors) do
  local root=C.U.root(b.Model)
  if b~=a and b.Alive and b.Team~=a.Team and root and (root.Position-center).Magnitude&lt;=radius and self:Visible(center,b,{a.Model}) then
   local dealt=C.DamageService:Apply(a,b,damage,center,knock)
   if dealt&gt;0 then hits=hits+1; if stun then b.StunUntil=math.max(b.StunUntil or 0,os.clock()+stun) end end
  end
 end
 return hits
end
function S:Targets(a,range)
 local out={}; local root=self.C.U.root(a.Model); if not root then return out end
 for _,b in pairs(self.C.CharacterService.Actors) do
  local br=self.C.U.root(b.Model)
  if b.Alive and b.Participant and b.Team~=a.Team and br and (br.Position-root.Position).Magnitude&lt;=range then table.insert(out,b) end
 end
 table.sort(out,function(x,y) return (self.C.U.root(x.Model).Position-root.Position).Magnitude&lt;(self.C.U.root(y.Model).Position-root.Position).Magnitude end)
 return out
end
return S
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2156"><Properties><string name="Name">DamageService</string><ProtectedString name="Source">local S={}
function S:Init(ctx) self.C=ctx end
function S:Apply(attacker,target,amount,origin,knock)
 local C=self.C
 if not C.RoundService:IsCombat() or not attacker or not attacker.Alive or not target.Alive then return 0 end
 if attacker.Team==target.Team or not target.Participant then return 0 end
 if not C.U.finite(amount) or amount&lt;=0 then return 0 end
 local h=C.U.humanoid(target.Model); local root=C.U.root(target.Model)
 if not h or not root or h.Health&lt;=0 or os.clock()&lt;(target.ShieldUntil or 0) then return 0 end
 local multiplier=1-(target.Definition.Defense or 0)
 if target.Team==&quot;Curses&quot; then multiplier=multiplier*(1+0.08*(C.MapService.Seals or 0)) end
 local damage=math.min(h.Health,amount*multiplier)
 target.LastAttacker=attacker; target.LastHitAt=os.clock()
 h:TakeDamage(damage)
 attacker.Damage=(attacker.Damage or 0)+damage; attacker.Ultimate=math.min(100,(attacker.Ultimate or 0)+damage*0.12)
 attacker.Actions=(attacker.Actions or 0)+1
 if attacker.Player then C.QuestService:Progress(attacker.Player,&quot;Damage&quot;,math.floor(damage)) end
 if knock and origin then
  local v=root.Position-origin; if v.Magnitude&gt;0.1 then
   root.AssemblyLinearVelocity=v.Unit*knock+Vector3.new(0,12,0); target.MotionGrace=os.clock()+1.3
  end
 end
 C.Remotes.Effect:FireAllClients(&quot;Hit&quot;,root.Position,{255,240,220},3,target.Model)
 if h.Health&lt;=0 then C.CharacterService:Die(target) end
 return damage
end
function S:Heal(a,target,amount)
 if not a.Alive or not target.Alive or a.Team~=target.Team or not target.Participant then return 0 end
 local h=self.C.U.humanoid(target.Model); if not h then return 0 end
 local healed=math.min(amount,h.MaxHealth-h.Health); h.Health=h.Health+healed
 if target~=a and healed&gt;0 then
  a.Healed=(a.Healed or 0)+healed; a.Actions=a.Actions+1; a.Ultimate=math.min(100,a.Ultimate+healed*0.2)
  if a.Player then self.C.QuestService:Progress(a.Player,&quot;Help&quot;,1) end
 end
 return healed
end
return S
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2157"><Properties><string name="Name">DestructionService</string><ProtectedString name="Source">local S={}
function S:Init(ctx) self.C=ctx; self.Broken=0 end
function S:Blast(position,radius,power)
 local map=self.C.MapService.Active; if not map then return end
 local folder=map:FindFirstChild(&quot;Destructibles&quot;); if not folder then return end
 for _,p in ipairs(folder:GetChildren()) do
  if p:IsA(&quot;BasePart&quot;) and p.CanCollide and (p.Position-position).Magnitude&lt;radius+p.Size.Magnitude*0.25 then
   local hp=(p:GetAttribute(&quot;Health&quot;) or 30)-power; p:SetAttribute(&quot;Health&quot;,hp)
   if hp&lt;=0 then
    self.Broken=self.Broken+1; p.CanCollide=false; p.CanTouch=false; p.CanQuery=false; p.Transparency=1
    self.C.Remotes.Effect:FireAllClients(&quot;Debris&quot;,p.Position,{p.Color.R*255,p.Color.G*255,p.Color.B*255},math.min(p.Size.Magnitude,10))
   end
  end
 end
end
return S
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2158"><Properties><string name="Name">MapService</string><ProtectedString name="Source">local SS=game:GetService(&quot;ServerStorage&quot;)
local S={}
function S:Init(ctx) self.C=ctx; self.Connections={}; self.Seals=0; self.Holds={} end
function S:Load(id,mode)
 self:Cleanup(); local template=SS.Maps:FindFirstChild(id); assert(template,&quot;Missing map &quot;..id)
 self.Active=template:Clone(); self.Active.Name=&quot;ActiveMap&quot;; self.Active.Parent=workspace
 self.Seals=0; self.Mode=mode; self.C.DestructionService.Broken=0
 for _,p in ipairs(self.Active.Destructibles:GetChildren()) do
  local tier=string.match(p.Name,&quot;^(%w+)_&quot;); p:SetAttribute(&quot;Tier&quot;,tier)
  p:SetAttribute(&quot;Health&quot;,tier==&quot;Heavy&quot; and 130 or tier==&quot;Medium&quot; and 65 or 25)
 end
 if mode==&quot;Clash&quot; then
  local arena=Instance.new(&quot;Part&quot;); arena.Name=&quot;ClashArena&quot;; arena.Shape=Enum.PartType.Cylinder; arena.Size=Vector3.new(0.2,70,70)
  arena.CFrame=CFrame.new(0,0.5,0)*CFrame.Angles(0,0,math.pi/2); arena.Anchored=true; arena.Material=Enum.Material.Marble; arena.Color=Color3.fromRGB(55,51,85); arena.Parent=self.Active
 end
 local objs=self.Active:FindFirstChild(&quot;Objectives&quot;)
 for i,p in ipairs(objs:GetChildren()) do
  p:SetAttribute(&quot;Activated&quot;,false)
  local prompt=Instance.new(&quot;ProximityPrompt&quot;); prompt.Name=&quot;SealPrompt&quot;; prompt.ActionText=&quot;Активировать&quot;; prompt.ObjectText=&quot;Печать &quot;..i
  prompt.KeyboardKeyCode=Enum.KeyCode.Y; prompt.HoldDuration=4; prompt.MaxActivationDistance=10; prompt.RequiresLineOfSight=true; prompt.Enabled=mode~=&quot;Clash&quot;; prompt.Parent=p
  self.Connections[#self.Connections+1]=prompt.PromptButtonHoldBegan:Connect(function(player)
   self.Holds[player]={Part=p,Since=os.clock(),Last=os.clock(),Progress=0}
  end)
  self.Connections[#self.Connections+1]=prompt.PromptButtonHoldEnded:Connect(function(player)
   local hold=self.Holds[player]; if hold and hold.Part==p and hold.Progress&lt;3.5 then self.Holds[player]=nil end
  end)
  self.Connections[#self.Connections+1]=prompt.Triggered:Connect(function(player)
   local a=self.C.CharacterService.ByPlayer[player]; local root=a and self.C.U.root(a.Model); local hold=self.Holds[player]
   if not self.C.RoundService:IsCombat() or not a or not a.Alive or not a.Participant or a.Team~=&quot;Sorcerers&quot; then return end
   if not root or (root.Position-p.Position).Magnitude&gt;12 or not hold or hold.Part~=p or hold.Progress&lt;3.5 then return end
   if p:GetAttribute(&quot;Activated&quot;) then return end
   p:SetAttribute(&quot;Activated&quot;,true); prompt.Enabled=false; p.Color=Color3.fromRGB(80,255,200); self.Seals=self.Seals+1; self.Holds[player]=nil
   a.Actions=a.Actions+3; a.Ultimate=math.min(100,a.Ultimate+25); a.Objectives=(a.Objectives or 0)+1
   self.C.QuestService:Progress(player,&quot;Help&quot;,1)
   self.C.Remotes.Effect:FireAllClients(&quot;Burst&quot;,p.Position,{80,255,200},15)
  end)
 end
 local pickups=self.Active:FindFirstChild(&quot;Pickups&quot;)
 for _,p in ipairs(pickups:GetChildren()) do
  local prompt=Instance.new(&quot;ProximityPrompt&quot;); prompt.ActionText=&quot;Подобрать&quot;; prompt.ObjectText=&quot;Проклятая энергия +35&quot;
  prompt.KeyboardKeyCode=Enum.KeyCode.Y; prompt.HoldDuration=0.2; prompt.MaxActivationDistance=8; prompt.Parent=p
  self.Connections[#self.Connections+1]=prompt.Triggered:Connect(function(player)
   local a=self.C.CharacterService.ByPlayer[player]; local root=a and self.C.U.root(a.Model)
   if not self.C.RoundService:IsCombat() or not a or not a.Participant or not a.Alive or not root or (root.Position-p.Position).Magnitude&gt;10 or not prompt.Enabled then return end
   if a.Energy&gt;=100 then return end
   prompt.Enabled=false; p.Transparency=1; a.Energy=math.min(100,a.Energy+35)
  end)
 end
end
function S:Spawn(index,team)
 if self.Mode==&quot;Clash&quot; then return CFrame.new((team==&quot;Curses&quot; and 1 or -1)*27,5,(index-1)*5-15) end
 local folder=self.Active and self.Active:FindFirstChild(&quot;SpawnPoints&quot;)
 local list=folder and folder:GetChildren() or {}; table.sort(list,function(a,b) return a.Name&lt;b.Name end)
 if #list==0 then return CFrame.new(0,8,0) end
 local offset=team==&quot;Curses&quot; and math.floor(#list/2) or 0
 return list[((index-1+offset)%#list)+1].CFrame+Vector3.new(0,4,0)
end
function S:Step(dt)
 for p,hold in pairs(self.Holds) do
  local a=self.C.CharacterService.ByPlayer[p]; local root=a and self.C.U.root(a.Model)
  if not root or not a.Alive or not hold.Part.Parent or not self.C.RoundService:IsCombat() or (root.Position-hold.Part.Position).Magnitude&gt;12 then self.Holds[p]=nil
  else
   local hit=self.C.CombatService:Ray(root.Position,hold.Part.Position-root.Position,{a.Model})
   if hit and hit.Instance~=hold.Part then self.Holds[p]=nil else hold.Progress=hold.Progress+dt end
  end
 end
end
function S:Cleanup()
 for _,c in ipairs(self.Connections) do c:Disconnect() end; self.Connections={}; self.Holds={}
 if self.Active then self.Active:Destroy(); self.Active=nil end
 self.Seals=0
end
return S

