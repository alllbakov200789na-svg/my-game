 self.Detail=label(self.Top,&quot;&quot;,11); self.Detail.TextColor3=Color3.fromRGB(160,165,195); self.Detail.Position=UDim2.fromOffset(14,73); self.Detail.Size=UDim2.new(1,-28,0,20)
