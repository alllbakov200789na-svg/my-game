function S:Init(ctx) self.C=ctx end
function S:Eligible(count)
 local out={}; for id,m in pairs(self.C.Modes) do if count&gt;=m.MinPlayers then table.insert(out,id) end end
 table.sort(out); return out
end
-- Pure decision function. Snapshot counts exclude ordinary NPCs.
function S.Decide(mode,s,timedOut)
 if s.Sorcerers==0 and s.Curses==0 and mode~=&quot;Survival&quot; then return &quot;Draw&quot;,&quot;Обе команды устранены&quot; end
 if s.Sorcerers==0 then return &quot;Curses&quot;,&quot;Команда магов устранена&quot; end
 if mode==&quot;Survival&quot; then
  if s.BossDefeated and s.Seals&gt;=3 then return &quot;Sorcerers&quot;,&quot;Босс побеждён, защитный контур восстановлен&quot; end
  if timedOut then return &quot;Curses&quot;,&quot;Ритуал не завершён вовремя&quot; end
 elseif mode==&quot;Clash&quot; then
  if not s.SorcererLeader and not s.CurseLeader then return &quot;Draw&quot;,&quot;Оба лидера устранены&quot; end
  if not s.CurseLeader then return &quot;Sorcerers&quot;,&quot;Лидер проклятий устранён&quot; end
  if not s.SorcererLeader then return &quot;Curses&quot;,&quot;Лидер магов устранён&quot; end
  if timedOut then
   if math.abs(s.SorcererScore-s.CurseScore)&lt;0.01 then return &quot;Draw&quot;,&quot;Равный счёт&quot; end
   return s.SorcererScore&gt;s.CurseScore and &quot;Sorcerers&quot; or &quot;Curses&quot;,&quot;Победа по очкам здоровья&quot;
  end
 elseif mode==&quot;Invasion&quot; then
  if s.Curses==0 or s.Seals&gt;=3 then return &quot;Sorcerers&quot;,&quot;Проклятия запечатаны&quot; end
  if timedOut then return &quot;Curses&quot;,&quot;Вторжение не остановлено&quot; end
 elseif mode==&quot;Hunt&quot; or (mode==&quot;Betrayal&quot; and s.Revealed) then
  if s.Curses==0 then return &quot;Sorcerers&quot;,&quot;Главное проклятие побеждено&quot; end
  if timedOut then return s.Seals&gt;=3 and &quot;Sorcerers&quot; or &quot;Curses&quot;,s.Seals&gt;=3 and &quot;Спасение через печати&quot; or &quot;Печати не активированы&quot; end
 elseif mode==&quot;Betrayal&quot; and timedOut then return &quot;Draw&quot;,&quot;Носитель не появился&quot; end
 return nil
end
function S:Snapshot()
 local C=self.C; local r=C.RoundService
 local s={Sorcerers=0,Curses=0,SorcererLeader=false,CurseLeader=false,SorcererScore=0,CurseScore=0,
 Seals=C.MapService.Seals or 0,BossDefeated=C.NPCService.BossDefeated,Revealed=r.Revealed}
 for _,a in pairs(C.CharacterService.Actors) do
  if a.Player and a.Participant and a.Alive and a.Player.Parent then
   s[a.Team]=s[a.Team]+1; local h=C.U.humanoid(a.Model)
   local key=a.Team==&quot;Sorcerers&quot; and &quot;SorcererScore&quot; or &quot;CurseScore&quot;
   s[key]=s[key]+(h and h.Health/h.MaxHealth or 0)*100
   if a.Role==&quot;Gojo&quot; then s.SorcererLeader=true elseif a.Role==&quot;Sukuna&quot; then s.CurseLeader=true end
  end
 end
 return s
end
return S
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2160"><Properties><string name="Name">MonetizationService</string><ProtectedString name="Source">local Marketplace=game:GetService(&quot;MarketplaceService&quot;)
local Players=game:GetService(&quot;Players&quot;)
local S={}
function S:Init(ctx)
 self.C=ctx
 Marketplace.ProcessReceipt=function(receipt)
  local p=Players:GetPlayerByUserId(receipt.PlayerId); if not p then return Enum.ProductPurchaseDecision.NotProcessedYet end
  local product
  for _,v in pairs(ctx.Config.Products) do if v.Id&gt;0 and v.Id==receipt.ProductId then product=v; break end end
  if not product then warn(&quot;Unknown product receipt&quot;,receipt.ProductId); return Enum.ProductPurchaseDecision.NotProcessedYet end
  if ctx.PlayerDataService:Receipt(p,tostring(receipt.PurchaseId),product) then
   ctx.Remotes.Profile:FireClient(p,ctx.PlayerDataService:Public(p)); return Enum.ProductPurchaseDecision.PurchaseGranted
  end
  return Enum.ProductPurchaseDecision.NotProcessedYet
 end
 Marketplace.PromptGamePassPurchaseFinished:Connect(function(p,_,bought) if bought then self:RefreshPasses(p) end end)
end
function S:RefreshPasses(p)
 for key,pass in pairs(self.C.Config.Passes) do
  if pass.Id&gt;0 then
   local ok,owns=pcall(function() return Marketplace:UserOwnsGamePassAsync(p.UserId,pass.Id) end)
   if ok and owns then self.C.PlayerDataService:Mutate(p,function(d)
    d.Entitlements[key]=true
    for _,id in ipairs(pass.Cosmetics or {}) do d.OwnedCosmetics[id]=true end
   end) end
  end
 end
end
function S:Purchase(p,id)
 local item=self.C.Config.Cosmetics[id]; if not item then return false end
 local ok,result=self.C.PlayerDataService:Mutate(p,function(d)
  if d.OwnedCosmetics[id] or d.Coins&lt;item.Price then return false end
  d.Coins=d.Coins-item.Price; d.OwnedCosmetics[id]=true; return true
 end)
 return ok and result
end
function S:Equip(p,id)
 if id~=&quot;&quot; and not self.C.Config.Cosmetics[id] then return false end
 local ok,result=self.C.PlayerDataService:Mutate(p,function(d)
  if id~=&quot;&quot; and not d.OwnedCosmetics[id] then return false end
  d.EquippedCosmetics=id; return true
 end)
 if ok and result then self.C.CharacterService:Cosmetic(p) end
 return ok and result
end
function S:Prompt(p,kind,key)
 local cfg=kind==&quot;Product&quot; and self.C.Config.Products[key] or self.C.Config.Passes[key]
 if not cfg or cfg.Id&lt;=0 or game:GetService(&quot;RunService&quot;):IsStudio() then return false end
 if kind==&quot;Product&quot; then Marketplace:PromptProductPurchase(p,cfg.Id) else Marketplace:PromptGamePassPurchase(p,cfg.Id) end
 return true
end
return S
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2161"><Properties><string name="Name">NPCService</string><ProtectedString name="Source">local Pathfinding=game:GetService(&quot;PathfindingService&quot;)
local S={}
function S:Init(ctx) self.C=ctx; self.NPCs={}; self.LastWave=0; self.Wave=0; self.BossDefeated=false; self.BossSpawned=false end
function S:Count() local n=0; for _ in pairs(self.NPCs) do n=n+1 end; return n end
function S:Spawn(kind,pos,owner,life)
 local C=self.C; if self:Count()&gt;=C.Config.MaxNPCs then return end
 local m=C.CharacterService.Template:Clone(); m.Name=kind
 local specs={Weak={55,12,6,1},Fast={38,23,5,0.8},Elite={140,14,12,1.25},Boss={400+120*C.RoundService.PlayerCount,15,19,2.2},ShadowDog={65,25,12,0.65}}
 local stat=specs[kind]; local h=C.U.humanoid(m)
 h.MaxHealth=stat[1]; h.Health=stat[1]; h.WalkSpeed=stat[2]; h.DisplayName=kind; h.BreakJointsOnDeath=false
 local team=owner and owner.Team or &quot;Curses&quot;
 C.CharacterService:Style(m,&quot;Curse&quot;,team); m:ScaleTo(stat[4]); m:SetAttribute(&quot;Faction&quot;,team); m:SetAttribute(&quot;NPC&quot;,true)
 m.Parent=workspace; m:PivotTo(CFrame.new(pos)); local root=C.U.root(m); root:SetNetworkOwner(nil)
 if kind==&quot;ShadowDog&quot; then
  for _,p in ipairs(m:GetDescendants()) do if p:IsA(&quot;BasePart&quot;) then p.Transparency=1 end end
  local function limb(name,size,offset,color)
   local p=Instance.new(&quot;Part&quot;); p.Name=name; p.Size=size; p.Color=color; p.Material=Enum.Material.SmoothPlastic; p.CanCollide=false; p.CanQuery=false; p.CanTouch=false; p.Massless=true
   p.CFrame=root.CFrame*CFrame.new(offset); p.Parent=m
   local w=Instance.new(&quot;WeldConstraint&quot;); w.Part0=root; w.Part1=p; w.Parent=p
  end
  local fur=Color3.fromRGB(39,29,62)
  limb(&quot;DogBody&quot;,Vector3.new(1.6,1.2,2.8),Vector3.new(0,-0.3,0),fur)
  limb(&quot;DogHead&quot;,Vector3.new(1.1,1.1,1.2),Vector3.new(0,0.2,-1.7),fur)
  for _,x in ipairs({-0.45,0.45}) do
   limb(&quot;Ear&quot;,Vector3.new(0.25,0.7,0.4),Vector3.new(x,1,-1.6),fur)
   limb(&quot;Eye&quot;,Vector3.new(0.15,0.15,0.12),Vector3.new(x,0.35,-2.32),Color3.fromRGB(170,100,255))
   for _,z in ipairs({-0.8,0.8}) do limb(&quot;Paw&quot;,Vector3.new(0.4,0.9,0.5),Vector3.new(x,-1,z),fur) end
  end
  limb(&quot;Tail&quot;,Vector3.new(0.3,0.5,1.1),Vector3.new(0,0.1,1.8),fur)
 end
 local a={Model=m,Role=kind,Team=team,Alive=true,Participant=true,Definition={Defense=kind==&quot;Boss&quot; and 0.1 or 0,WalkSpeed=stat[2],SprintSpeed=stat[2]},
 Energy=100,Stamina=100,Ultimate=0,Actions=0,Damage=0,Eliminations=0,Power=stat[3],NextHit=0,StunUntil=0,ShieldUntil=0,
 Owner=owner,Expires=life and os.clock()+life,NextPath=0,Token=C.RoundService.Token}
 C.CharacterService.Actors[m]=a; self.NPCs[m]=a
 a.Connection=h.Died:Connect(function()
  C.CharacterService:Die(a)
  if kind==&quot;Boss&quot; then self.BossDefeated=true end
  task.delay(2,function() self:Remove(m) end)
 end)
 return a
end
function S:Remove(m)
 local a=self.NPCs[m]; if not a then return end
 if a.Connection then a.Connection:Disconnect() end
 self.NPCs[m]=nil; self.C.CharacterService.Actors[m]=nil; m:Destroy()
end
function S:Summon(owner,def,token)
 if token~=self.C.RoundService.Token then return end
 local root=self.C.U.root(owner.Model)
 local a=self:Spawn(&quot;ShadowDog&quot;,root.Position+root.CFrame.LookVector*5,owner,def.Duration)
 if a then a.Power=def.Damage end
end
function S:Step()
 local C=self.C; local r=C.RoundService; if not r:IsCombat() then return end
 local now=os.clock(); local elapsed=now-r.StartedAt
 local waves=r.Mode==&quot;Survival&quot; or r.Mode==&quot;Invasion&quot; or (r.Mode==&quot;Betrayal&quot; and not r.Revealed)
 if waves and now-self.LastWave&gt;C.Config.WaveSeconds and elapsed&lt;C.Config.RoundSeconds-25 then
  self.LastWave=now; self.Wave=self.Wave+1
  local n=math.min(2+math.floor(r.PlayerCount/3),7)
  for i=1,n do
   local angle=C.Rng:NextNumber()*math.pi*2
   self:Spawn(self.Wave%3==0 and &quot;Elite&quot; or (i%2==0 and &quot;Fast&quot; or &quot;Weak&quot;),Vector3.new(math.cos(angle)*100,5,math.sin(angle)*100))
  end
 end
 if r.Mode==&quot;Survival&quot; and not self.BossSpawned and elapsed&gt;=135 then
  if self:Count()&gt;=C.Config.MaxNPCs then for m,a in pairs(self.NPCs) do if not a.Owner then self:Remove(m); break end end end
  local boss=self:Spawn(&quot;Boss&quot;,Vector3.new(0,7,0))
  if boss then self.BossSpawned=true; C.Remotes.Effect:FireAllClients(&quot;Scare&quot;,Vector3.new(0,7,0),{255,80,100},18,boss.Model) end
 end
 local pathBudget=2
 for m,a in pairs(self.NPCs) do
  local root=C.U.root(m); local h=C.U.humanoid(m)
  if not root or not h or (a.Expires and now&gt;a.Expires) or (a.Owner and not a.Owner.Alive) or root.Position.Y&lt;C.Config.KillY then self:Remove(m)
  elseif a.Alive then
   local targets=C.CombatService:Targets(a,220); local target=targets[1]; local tr=target and C.U.root(target.Model)
   if tr and now&gt;a.StunUntil then
    h.WalkSpeed=a.Definition.WalkSpeed
    local distance=(tr.Position-root.Position).Magnitude
    if distance&lt;7+(a.Role==&quot;Boss&quot; and 3 or 0) and now&gt;a.NextHit and C.CombatService:Visible(root.Position,target,{m}) then
     a.NextHit=now+1.1; C.DamageService:Apply(a.Owner or a,target,a.Power,root.Position,15)
     C.Remotes.Effect:FireAllClients(&quot;Cast&quot;,root.Position,{255,75,100},4,m,&quot;Basic&quot;)
    end
    if C.CombatService:Visible(root.Position,target,{m}) then h:MoveTo(tr.Position)
    elseif now&gt;a.NextPath and not a.PathPending and pathBudget&gt;0 then
     pathBudget=pathBudget-1; a.PathPending=true; a.NextPath=now+2
     local start=root.Position; local goal=tr.Position; local token=r.Token
     task.spawn(function()
      local path=Pathfinding:CreatePath({AgentRadius=a.Role==&quot;Boss&quot; and 3 or 2,AgentHeight=6,AgentCanJump=true})
      local ok=pcall(function() path:ComputeAsync(start,goal) end)
      if ok and a.Alive and self.NPCs[m] and token==r.Token and path.Status==Enum.PathStatus.Success then a.Waypoints=path:GetWaypoints(); a.Waypoint=2 end
      a.PathPending=false
     end)
    elseif a.Waypoints then
     local wp=a.Waypoints[a.Waypoint]
     if wp then h:MoveTo(wp.Position); if wp.Action==Enum.PathWaypointAction.Jump then h.Jump=true end
      if (wp.Position-root.Position).Magnitude&lt;5 then a.Waypoint=a.Waypoint+1 end
     end
    end
   else h.WalkSpeed=0 end
  end
 end
end
function S:Cleanup()
 local list={}; for m in pairs(self.NPCs) do table.insert(list,m) end
 for _,m in ipairs(list) do self:Remove(m) end
 self.Wave=0; self.LastWave=0; self.BossDefeated=false; self.BossSpawned=false
end
return S
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2162"><Properties><string name="Name">PlayerDataService</string><ProtectedString name="Source">local DS=game:GetService(&quot;DataStoreService&quot;)
local Run=game:GetService(&quot;RunService&quot;)
local Http=game:GetService(&quot;HttpService&quot;)
local S={}
local function fresh()
 return {SchemaVersion=1,Coins=0,Level=1,XP=0,TotalWins=0,TotalMatches=0,Eliminations=0,SorcererWins=0,CurseWins=0,
 OwnedCosmetics={},EquippedCosmetics=&quot;&quot;,DailyRewardTimestamp=0,QuestProgress={},RolePity=0,
 ProcessedPurchaseReceipts={},Loadouts={},Settings={},Entitlements={}}
end
function S:Init(ctx)
 self.C=ctx; self.Profiles={}; self.Session=game.JobId~=&quot;&quot; and game.JobId or Http:GenerateGUID(false)
 self.Memory=Run:IsStudio(); if not self.Memory then self.Store=DS:GetDataStore(ctx.Config.DataStoreName) end
 task.spawn(function() while not self.Closing do task.wait(ctx.Config.AutosaveSeconds)
  for p in pairs(self.Profiles) do task.spawn(function() self:Save(p,false) end) end
 end end)
end
function S:Load(p)
 local profile={Data=fresh(),Busy=false,Valid=true,Persistent=not self.Memory}
 if not self.Memory then
  local ok,result
  for attempt=1,4 do
   ok,result=pcall(function() return self.Store:UpdateAsync(&quot;u_&quot;..p.UserId,function(old)
    old=old or {Data=fresh()}
    if old.Lease and old.Lease.Session~=self.Session and old.Lease.Expires&gt;os.time() then return nil end
    old.Lease={Session=self.Session,Expires=os.time()+self.C.Config.LeaseSeconds}; return old
   end) end)
   if ok and result then break end; task.wait(attempt*1.5)
  end
  if not ok or not result then p:Kick(&quot;Данные временно недоступны или открыты на другом сервере. Повторите вход позже.&quot;); return false end
  for k,v in pairs(fresh()) do if result.Data[k]==nil then result.Data[k]=v end end
  profile.Data=result.Data
 end
 self.Profiles[p]=profile
 p:SetAttribute(&quot;DataMode&quot;,self.Memory and &quot;STUDIO · прогресс не сохраняется&quot; or &quot;Облачное сохранение&quot;)
 return true
end
function S:Get(p) local f=self.Profiles[p]; return f and f.Valid and f.Data end
function S:Acquire(p)
 local f=self.Profiles[p]; if not f then return end
 local deadline=os.clock()+20
 while f.Busy and f.Valid and os.clock()&lt;deadline do task.wait(0.05) end
 if not f.Valid or f.Busy then return end; f.Busy=true; return f
end
function S:Mutate(p,fn)
 local f=self:Acquire(p); if not f then return false end
 local ok,result=pcall(fn,f.Data); f.Busy=false
 if not ok then warn(&quot;Profile mutation:&quot;,result); return false end
 return true,result
end
function S:Persist(p,f,data,release)
 local ok,result
 for attempt=1,3 do
  ok,result=pcall(function() return self.Store:UpdateAsync(&quot;u_&quot;..p.UserId,function(old)
   if not old or not old.Lease or old.Lease.Session~=self.Session then return nil end
   return {Data=data,Lease=not release and {Session=self.Session,Expires=os.time()+self.C.Config.LeaseSeconds} or nil}
  end) end)
  if ok and result then return true end
  task.wait(attempt)
 end
 -- Fail closed. Never overwrite an uncertain purchase with an older in-memory snapshot.
 f.Valid=false; warn(&quot;Profile persistence failed&quot;,p.UserId,tostring(result))
 if p.Parent then p:Kick(&quot;Сохранение временно недоступно. Сессия закрыта для защиты данных; войдите позже.&quot;) end
 return false
end
function S:Save(p,release)
 local f=self:Acquire(p); if not f then if release then self.Profiles[p]=nil end; return false end
 local ok=true
 if f.Persistent then ok=self:Persist(p,f,self.C.U.copy(f.Data),release) end
 f.Busy=false
 if release then f.Valid=false; self.Profiles[p]=nil end
 return ok
end
function S:Receipt(p,purchaseId,product)
 local f=self:Acquire(p); if not f or not f.Persistent then if f then f.Busy=false end; return false end
 if f.Data.ProcessedPurchaseReceipts[purchaseId] then f.Busy=false; return true end
 local nextData=self.C.U.copy(f.Data)
 nextData.Coins=nextData.Coins+(product.Coins or 0)
 for _,id in ipairs(product.Cosmetics or {}) do nextData.OwnedCosmetics[id]=true end
 nextData.ProcessedPurchaseReceipts[purchaseId]=os.time()
 local ok=self:Persist(p,f,nextData,false)
 if ok then f.Data=nextData end
 f.Busy=false; return ok
end
function S:Public(p)
 local d=self:Get(p); if not d then return nil end
 local out={}
 for _,k in ipairs({&quot;Coins&quot;,&quot;Level&quot;,&quot;XP&quot;,&quot;TotalWins&quot;,&quot;TotalMatches&quot;,&quot;Eliminations&quot;,&quot;SorcererWins&quot;,&quot;CurseWins&quot;,&quot;OwnedCosmetics&quot;,&quot;EquippedCosmetics&quot;,&quot;DailyRewardTimestamp&quot;,&quot;QuestProgress&quot;,&quot;Loadouts&quot;,&quot;Settings&quot;,&quot;Entitlements&quot;}) do out[k]=self.C.U.copy(d[k]) end
 return out
end
return S
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2163"><Properties><string name="Name">QuestService</string><ProtectedString name="Source">local S={}
S.Definitions={
 {Id=&quot;Rounds&quot;,Name=&quot;Сыграть 3 активных раунда&quot;,Goal=3,Reward=120,Period=&quot;Daily&quot;},
 {Id=&quot;Survive&quot;,Name=&quot;Выжить 2 раза&quot;,Goal=2,Reward=100,Period=&quot;Daily&quot;},
 {Id=&quot;Damage&quot;,Name=&quot;Нанести 1000 урона&quot;,Goal=1000,Reward=250,Period=&quot;Weekly&quot;},
 {Id=&quot;Curse&quot;,Name=&quot;Победить 3 проклятия&quot;,Goal=3,Reward=120,Period=&quot;Daily&quot;},
 {Id=&quot;Help&quot;,Name=&quot;Помочь союзникам 8 раз&quot;,Goal=8,Reward=200,Period=&quot;Weekly&quot;},
 {Id=&quot;Abilities&quot;,Name=&quot;Применить 12 разных техник за раунды&quot;,Goal=12,Reward=180,Period=&quot;Weekly&quot;},
}
function S:Init(ctx) self.C=ctx end
function S:Reset(d)
 local now=os.time(); local keys={Daily=math.floor(now/86400),Weekly=math.floor((now+3*86400)/604800)}
 for _,q in ipairs(self.Definitions) do
  local old=d.QuestProgress[q.Id]
  if not old or old.Period~=keys[q.Period] then d.QuestProgress[q.Id]={Period=keys[q.Period],Value=0,Claimed=false} end
 end
end
function S:Progress(p,id,n)
 if n&lt;=0 then return end
 self.C.PlayerDataService:Mutate(p,function(d) self:Reset(d); local q=d.QuestProgress[id]; if q then q.Value=q.Value+n end end)
end
function S:Claim(p,id)
 local q; for _,v in ipairs(self.Definitions) do if v.Id==id then q=v end end
 if not q then return false end
 local ok,result=self.C.PlayerDataService:Mutate(p,function(d)
  self:Reset(d); local v=d.QuestProgress[id]
  if v.Claimed or v.Value&lt;q.Goal then return false end
  v.Claimed=true; d.Coins=d.Coins+q.Reward; return true
 end)
 return ok and result
end
function S:Daily(p)
 local ok,result=self.C.PlayerDataService:Mutate(p,function(d)
  if os.time()-d.DailyRewardTimestamp&lt;86400 then return false end
  d.DailyRewardTimestamp=os.time(); d.Coins=d.Coins+self.C.Config.DailyCoins; return true
 end)
 return ok and result
end
return S
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2164"><Properties><string name="Name">RewardService</string><ProtectedString name="Source">local S={}
function S:Init(ctx) self.C=ctx; self.Awarded={} end
function S:Award(roundId,winner,reason)
 if self.Awarded[roundId] then return end
 self.Awarded={[roundId]=true}; local C=self.C
 for p,a in pairs(C.CharacterService.ByPlayer) do
  if a.Participant and p.Parent then
   local active=a.Actions&gt;=C.Config.AFKMinimumActions and a.ActiveSeconds&gt;=C.Config.AFKMinimumSeconds
   local won=a.Team==winner; local scale=C.RoundService.PlayerCount==1 and 0.5 or 1
   local coins=active and math.floor((25+(won and C.Modes[C.RoundService.Mode].Reward or 0)+math.min(30,(a.Objectives or 0)*10))*scale) or 0
   local xp=active and math.floor((40+(won and 70 or 0)+math.min(40,(a.Damage or 0)/30))*scale) or 0
   C.PlayerDataService:Mutate(p,function(d)
    if active then
     d.Coins=d.Coins+coins; d.XP=d.XP+xp; d.Level=1+math.floor(math.sqrt(d.XP/100)); d.TotalMatches=d.TotalMatches+1
     if won then d.TotalWins=d.TotalWins+1; local key=a.Team==&quot;Curses&quot; and &quot;CurseWins&quot; or &quot;SorcererWins&quot;; d[key]=d[key]+1 end
     if d.Level&gt;=5 then d.OwnedCosmetics.Azure=true end
    end
   end)
   if active then C.QuestService:Progress(p,&quot;Rounds&quot;,1); if a.Alive then C.QuestService:Progress(p,&quot;Survive&quot;,1) end end
   C.Remotes.Results:FireClient(p,{Winner=winner,Won=won,Reason=reason,Coins=coins,XP=xp,Damage=math.floor(a.Damage or 0),
    Eliminations=a.Eliminations or 0,Active=active,Profile=C.PlayerDataService:Public(p)})
  end
 end
end
return S
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2165"><Properties><string name="Name">RoleService</string><ProtectedString name="Source">local S={}
function S:Init(ctx) self.C=ctx end
function S:Abilities(rng)
 local A=self.C.Abilities; local pool=self.C.U.shuffle(A.Pool,rng); local first=pool[1]
 for i=2,#pool do if not (A.Incompatible[first] and A.Incompatible[first][pool[i]]) then return {first,pool[i]} end end
 error(&quot;No compatible ability pair&quot;)
end
function S:Assign(players,mode,rng)
 local C=self.C; local remaining=table.clone(players); local roles={}
 local function pick(role,team)
  local sum=0
  for _,p in ipairs(remaining) do local d=C.PlayerDataService:Get(p); sum=sum+1+math.min(d and d.RolePity or 0,15)*0.3 end
  local n=rng:NextNumber()*sum; local chosen=#remaining
  for i,p in ipairs(remaining) do local d=C.PlayerDataService:Get(p); n=n-(1+math.min(d and d.RolePity or 0,15)*0.3); if n&lt;=0 then chosen=i; break end end
  local p=table.remove(remaining,chosen); if p then roles[p]={Role=role,Team=team,Special=true}; return p end
  return nil
 end
 local carrier
 if mode==&quot;Hunt&quot; or mode==&quot;Clash&quot; then pick(&quot;Sukuna&quot;,&quot;Curses&quot;); pick(&quot;Gojo&quot;,&quot;Sorcerers&quot;)
 elseif mode==&quot;Invasion&quot; then pick(&quot;Curse&quot;,&quot;Curses&quot;); pick(&quot;Curse&quot;,&quot;Curses&quot;)
 elseif mode==&quot;Betrayal&quot; then carrier=pick(&quot;Sorcerer&quot;,&quot;Sorcerers&quot;) end
 local counts={Sorcerers=0,Curses=0}; for _,r in pairs(roles) do counts[r.Team]=counts[r.Team]+1 end
 for _,p in ipairs(C.U.shuffle(remaining,rng)) do
  local team=&quot;Sorcerers&quot;
  if mode==&quot;Clash&quot; and counts.Curses&lt;counts.Sorcerers then team=&quot;Curses&quot; end
  roles[p]={Role=&quot;Sorcerer&quot;,Team=team}; counts[team]=counts[team]+1
 end
 for p,r in pairs(roles) do
  r.Abilities=r.Role==&quot;Sorcerer&quot; and self:Abilities(rng) or table.clone(C.Characters[r.Role].AbilitySet)
  C.PlayerDataService:Mutate(p,function(d) d.RolePity=r.Special and 0 or math.min(50,d.RolePity+1) end)
 end
 return roles,carrier
end
return S
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2166"><Properties><string name="Name">RoundService</string><ProtectedString name="Source">local Players=game:GetService(&quot;Players&quot;)
local S={}
local nextStates={
 WaitingForPlayers={Intermission=true},Intermission={VotingOrSelection=true,WaitingForPlayers=true},
 VotingOrSelection={Loading=true,WaitingForPlayers=true},Loading={Intro=true,Cleanup=true},Intro={InProgress=true,Cleanup=true},
 InProgress={SuddenDeath=true,Results=true,Cleanup=true},SuddenDeath={Results=true,Cleanup=true},
 Results={Cleanup=true},Cleanup={WaitingForPlayers=true},
}
function S:Init(ctx)
 self.C=ctx; self.State=&quot;WaitingForPlayers&quot;; self.Token=0; self.RoundId=0; self.PlayerCount=0; self.Deadline=0; self.TeamWins={Sorcerers=0,Curses=0}
end
function S:IsCombat() return self.State==&quot;InProgress&quot; or self.State==&quot;SuddenDeath&quot; end
function S:Transition(state,seconds)
 if state==self.State then return false end
 assert(nextStates[self.State] and nextStates[self.State][state],&quot;Illegal transition &quot;..self.State..&quot; -&gt; &quot;..state)
 self.State=state; self.Deadline=workspace:GetServerTimeNow()+(seconds or 0); self:Broadcast(); return true
end
function S:EligiblePlayers()
 local list={}; for _,p in ipairs(Players:GetPlayers()) do if self.C.PlayerDataService:Get(p) and p:GetAttribute(&quot;Ready&quot;) then table.insert(list,p) end end
 return list
end
function S:Broadcast()
 local C=self.C; local alive=0
 for _,a in pairs(C.CharacterService.Actors) do if a.Player and a.Alive and a.Participant then alive=alive+1 end end
 local mode=self.Mode and C.Modes[self.Mode]
 C.Remotes.State:FireAllClients({State=self.State,Deadline=self.Deadline,Mode=mode and mode.Name or &quot;CURSED SURVIVAL&quot;,
 ModeId=self.Mode,Objective=mode and mode.Objective or &quot;Ожидание игроков. Один игрок запускает тренировку с NPC.&quot;,
 Map=self.MapName,Seals=C.MapService.Seals,Alive=alive,Wave=C.NPCService.Wave,NPCs=C.NPCService:Count(),
 RoundId=self.RoundId,TeamWins=self.TeamWins,Revealed=self.Revealed,Training=self.PlayerCount==1})
end
function S:Countdown(seconds,abortEmpty)
 local untilTime=os.clock()+seconds
 while os.clock()&lt;untilTime and not self.Closing do
  if abortEmpty and #self:EligiblePlayers()==0 then return false end
  self:Broadcast(); task.wait(math.min(0.5,math.max(0,untilTime-os.clock())))
 end
 return not self.Closing
end
function S:RevealCarrier()
 local C=self.C; local a=self.Carrier and C.CharacterService.ByPlayer[self.Carrier]
 if not a or not a.Alive or not self.Carrier.Parent then
  local candidates={}; for p,b in pairs(C.CharacterService.ByPlayer) do if b.Participant and b.Alive and p.Parent then table.insert(candidates,p) end end
  if #candidates&lt;2 then self.ForcedResult={&quot;Sorcerers&quot;,&quot;Носитель исчез; оставшиеся маги спасены&quot;}; return end
  self.Carrier=candidates[C.Rng:NextInteger(1,#candidates)]
 end
 if C.CharacterService:Transform(self.Carrier) then
  self.Revealed=true
  local b=C.CharacterService.ByPlayer[self.Carrier]
  C.Remotes.Role:FireClient(self.Carrier,{Name=b.Definition.DisplayName,Role=b.Role,Team=b.Team,Abilities=b.Abilities,Ultimate=b.Definition.UltimateAbility})
  C.Remotes.Effect:FireAllClients(&quot;Scare&quot;,C.U.root(b.Model).Position,{255,60,90},20,b.Model)
 end
end
function S:RunOne()
 local C=self.C
 while #self:EligiblePlayers()==0 and not self.Closing do self:Broadcast(); task.wait(1) end
 if self.Closing then return end
 self:Transition(&quot;Intermission&quot;,C.Config.Intermission)
 if not self:Countdown(C.Config.Intermission,true) then self:Transition(&quot;WaitingForPlayers&quot;); return end
 self:Transition(&quot;VotingOrSelection&quot;,C.Config.SelectionSeconds)
 if not self:Countdown(C.Config.SelectionSeconds,true) then self:Transition(&quot;WaitingForPlayers&quot;); return end
 local players=self:EligiblePlayers(); if #players==0 then self:Transition(&quot;WaitingForPlayers&quot;); return end
 self.PlayerCount=#players; local modes=C.ModeService:Eligible(#players); self.Mode=modes[C.Rng:NextInteger(1,#modes)]
 local map=C.Maps[C.Rng:NextInteger(1,#C.Maps)]; self.MapName=map.Name
 self.Token=self.Token+1; self.RoundId=self.RoundId+1; self.Revealed=false; self.ForcedResult=nil
 self:Transition(&quot;Loading&quot;,0); C.MapService:Load(map.Id,self.Mode)
 local roles,carrier=C.RoleService:Assign(players,self.Mode,C.Rng); self.Carrier=carrier
 -- Solo practice uses a durable hero and reduced rewards.
 if #players==1 then roles[players[1]]={Role=&quot;Gojo&quot;,Team=&quot;Sorcerers&quot;,Abilities=table.clone(C.Characters.Gojo.AbilitySet)} end
 local index=0
 for _,p in ipairs(players) do
  if p.Parent then
   index=index+1; local r=roles[p]; local a=C.CharacterService:Spawn(p,r.Role,r.Team,r.Abilities,C.MapService:Spawn(index,r.Team),true)
   C.Remotes.Role:FireClient(p,{Name=a.Definition.DisplayName,Role=a.Role,Team=a.Team,Abilities=a.Abilities,Ultimate=a.Definition.UltimateAbility})
  end
 end
 self:Transition(&quot;Intro&quot;,C.Config.IntroSeconds); self:Countdown(C.Config.IntroSeconds)
 self.StartedAt=os.clock(); self:Transition(&quot;InProgress&quot;,C.Config.RoundSeconds)
 local winner,reason
 while not winner and not self.Closing do
  if self.Mode==&quot;Betrayal&quot; and not self.Revealed and os.clock()-self.StartedAt&gt;=60 then self:RevealCarrier() end
  if self.ForcedResult then winner,reason=table.unpack(self.ForcedResult)
  else
   local expired=workspace:GetServerTimeNow()&gt;=self.Deadline
   winner,reason=C.ModeService.Decide(self.Mode,C.ModeService:Snapshot(),expired)
   if winner==&quot;Draw&quot; and expired and self.State==&quot;InProgress&quot; and self.Mode==&quot;Clash&quot; then
    winner=nil; self:Transition(&quot;SuddenDeath&quot;,C.Config.SuddenDeathSeconds)
   end
  end
  self:Broadcast(); if not winner then task.wait(0.5) end
 end
 if self.Closing then return end
 self:Transition(&quot;Results&quot;,C.Config.ResultsSeconds); self.Token=self.Token+1
 if self.TeamWins[winner] then self.TeamWins[winner]=self.TeamWins[winner]+1 end
 C.RewardService:Award(self.RoundId,winner,reason); self:Countdown(C.Config.ResultsSeconds)
 self:Cleanup()
end
function S:Cleanup()
 if self.State~=&quot;Cleanup&quot; then self:Transition(&quot;Cleanup&quot;) end
 self.Token=self.Token+1; self.C.NPCService:Cleanup()
 for _,p in ipairs(Players:GetPlayers()) do if self.C.PlayerDataService:Get(p) then self.C.CharacterService:Lobby(p) end end
 self.C.MapService:Cleanup(); workspace.GameplayEffects:ClearAllChildren()
 self.Mode=nil; self.MapName=nil; self.Carrier=nil; self.PlayerCount=0; self:Transition(&quot;WaitingForPlayers&quot;)
end
function S:Start()
 task.spawn(function()
  while not self.Closing do
   local ok,err=xpcall(function() self:RunOne() end,debug.traceback)
   if not ok then
    warn(&quot;Round recovery&quot;,err)
    self.Token=self.Token+1; self.State=&quot;Cleanup&quot;; self.C.NPCService:Cleanup(); self.C.MapService:Cleanup()
    for _,p in ipairs(Players:GetPlayers()) do if self.C.PlayerDataService:Get(p) then pcall(function() self.C.CharacterService:Lobby(p) end) end end
    self.State=&quot;WaitingForPlayers&quot;; self.Mode=nil; self.MapName=nil; task.wait(3)
   end
  end
 end)
end
return S
