</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2142"><Properties><string name="Name">CharacterDefinitions</string><ProtectedString name="Source">local C=require(script.Parent.Config)
local function char(id,name,original,team,hp,speed,sprint,power,defense,abilities,ultimate,color)
 return {CharacterId=id,DisplayName=C.UseOriginalNames and original or name,Team=team,BaseHealth=hp,
 WalkSpeed=speed,SprintSpeed=sprint,Stamina=100,Energy=100,AttackPower=power,Defense=defense,
 AbilitySet=abilities,UltimateAbility=ultimate,AnimationSet=&quot;ProceduralR15&quot;,VFXProfile=color,SFXProfile=id}
end
return {
 Sorcerer=char(&quot;Sorcerer&quot;,&quot;Маг&quot;,&quot;Маг&quot;,&quot;Sorcerers&quot;,100,17,26,12,0,{},nil,{137,117,255}),
 Gojo=char(&quot;Gojo&quot;,&quot;Годжо&quot;,&quot;Астра • хранитель пространства&quot;,&quot;Sorcerers&quot;,650,20,30,20,0.08,{&quot;Blue&quot;,&quot;Red&quot;,&quot;Infinity&quot;,&quot;Teleport&quot;,&quot;HollowPurple&quot;},&quot;UnlimitedVoid&quot;,{55,192,255}),
 Sukuna=char(&quot;Sukuna&quot;,&quot;Сукуна&quot;,&quot;Рэн • владыка разлома&quot;,&quot;Curses&quot;,850,18,27,26,0.12,{&quot;Cleave&quot;,&quot;Dismantle&quot;,&quot;FireAttack&quot;,&quot;CursedDash&quot;,&quot;Regeneration&quot;},&quot;MalevolentShrine&quot;,{255,63,91}),
 Curse=char(&quot;Curse&quot;,&quot;Главное проклятие&quot;,&quot;Высшее проклятие&quot;,&quot;Curses&quot;,430,19,28,22,0.06,{&quot;Dismantle&quot;,&quot;FireAttack&quot;,&quot;CursedDash&quot;,&quot;Regeneration&quot;},&quot;MalevolentShrine&quot;,{255,113,58}),
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2143"><Properties><string name="Name">Config</string><ProtectedString name="Source">return {
 Title=&quot;JUJUTSU: CURSED SURVIVAL&quot;, Version=&quot;0.1.0-alpha&quot;, MaxPlayers=15,
 RoundSeconds=240, Intermission=20, ResultsSeconds=10, SelectionSeconds=5, IntroSeconds=5, SuddenDeathSeconds=25,
 UseOriginalNames=true, -- Original analogues by default; gameplay IDs remain stable.
 DataStoreName=&quot;CursedSurvival_v1&quot;, SchemaVersion=1, LeaseSeconds=180, AutosaveSeconds=45,
 MaxNPCs=18, MaxDebris=32, ArenaRadius=145, KillY=-30, EnergyRegen=6, StaminaRegen=15,
 SprintDrain=22, NPCThinkSeconds=0.25, WaveSeconds=18, AFKMinimumActions=3, AFKMinimumSeconds=15, DailyCoins=100,
 StudioPersistence=false,
 Products={
  Coins={Id=0,Status=&quot;NOT_CONFIGURED&quot;,Coins=500,Name=&quot;500 монет&quot;},
  Chest={Id=0,Status=&quot;NOT_CONFIGURED&quot;,Cosmetics={&quot;Azure&quot;,&quot;Crimson&quot;},Name=&quot;Сундук: Azure + Crimson&quot;},
  Finisher={Id=0,Status=&quot;NOT_CONFIGURED&quot;,Cosmetics={&quot;Eclipse&quot;},Name=&quot;Эффект устранения Eclipse&quot;},
  Effects={Id=0,Status=&quot;NOT_CONFIGURED&quot;,Cosmetics={&quot;Violet&quot;},Name=&quot;Violet VFX&quot;},
  Bundle={Id=0,Status=&quot;NOT_CONFIGURED&quot;,Cosmetics={&quot;Gold&quot;,&quot;Violet&quot;},Name=&quot;Набор Gold + Violet&quot;},
 },
 Passes={
  VIP={Id=0,Name=&quot;VIP&quot;,Cosmetics={&quot;Gold&quot;}}, Auras={Id=0,Name=&quot;Anime Aura Collection&quot;,Cosmetics={&quot;Azure&quot;,&quot;Crimson&quot;,&quot;Violet&quot;}},
  Spawn={Id=0,Name=&quot;Exclusive Spawn FX&quot;,Cosmetics={&quot;Eclipse&quot;}}, Emotes={Id=0,Name=&quot;Premium Emotes&quot;,Emote=true},
  Loadouts={Id=0,Name=&quot;Extra Cosmetic Loadouts&quot;,Slots=3},
 },
 Cosmetics={
  Azure={Name=&quot;AZURE / небесная аура&quot;,Price=150,Color={65,198,255}},
  Crimson={Name=&quot;CRIMSON / багровая аура&quot;,Price=150,Color={255,65,95}},
  Violet={Name=&quot;VIOLET / след пустоты&quot;,Price=300,Color={168,95,255}},
  Gold={Name=&quot;GOLD / золотая аура&quot;,Price=500,Color={255,208,90}},
  Eclipse={Name=&quot;ECLIPSE / эффект устранения&quot;,Price=750,Color={240,225,255}},
 },
 Sounds={}, -- Owned audio IDs only. Empty means silent procedural effects.
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2144"><Properties><string name="Name">MapDefinitions</string><ProtectedString name="Source">return {
 {Id=&quot;ShibuyaCity&quot;,Name=&quot;SHIBUYA CITY&quot;,Subtitle=&quot;Неоновый перекрёсток&quot;,Accent={60,195,255}},
 {Id=&quot;SorcererAcademy&quot;,Name=&quot;SORCERER ACADEMY&quot;,Subtitle=&quot;Сад последнего рассвета&quot;,Accent={150,120,255}},
 {Id=&quot;CursedDistrict&quot;,Name=&quot;CURSED DISTRICT&quot;,Subtitle=&quot;За гранью разлома&quot;,Accent={255,65,110}},
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2145"><Properties><string name="Name">RoundDefinitions</string><ProtectedString name="Source">return {
 Hunt={Name=&quot;CURSED HUNT&quot;,MinPlayers=2,Reward=90,Objective=&quot;Победите владыку или активируйте 3 печати и доживите до конца.&quot;},
 Clash={Name=&quot;CLASH OF THE STRONGEST&quot;,MinPlayers=2,Reward=100,Objective=&quot;Защитите своего лидера и устраните лидера противника.&quot;},
 Invasion={Name=&quot;CURSE INVASION&quot;,MinPlayers=3,Reward=110,Objective=&quot;Уничтожьте двух главных проклятий или завершите 3 печати ритуала.&quot;},
 Survival={Name=&quot;SHIBUYA SURVIVAL&quot;,MinPlayers=1,Reward=80,Objective=&quot;Активируйте 3 защитных объекта и уничтожьте финального босса.&quot;},
 Betrayal={Name=&quot;CURSED BETRAYAL&quot;,MinPlayers=3,Reward=100,Objective=&quot;Носитель скрыт. Через 60 секунд начнётся охота. Готовьте печати!&quot;},
}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2146"><Properties><string name="Name">Types</string><ProtectedString name="Source">export type Actor={Model:Model,Player:Player?,Role:string,Team:string,Alive:boolean,Energy:number,
 Stamina:number,Ultimate:number,Abilities:{string},Cooldowns:{[string]:number}}
export type RoundState=&quot;WaitingForPlayers&quot;|&quot;Intermission&quot;|&quot;VotingOrSelection&quot;|&quot;Loading&quot;|&quot;Intro&quot;|&quot;InProgress&quot;|&quot;SuddenDeath&quot;|&quot;Results&quot;|&quot;Cleanup&quot;
return {}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2147"><Properties><string name="Name">Utility</string><ProtectedString name="Source">local U={}
function U.copy(t) if type(t)~=&quot;table&quot; then return t end local o={}; for k,v in pairs(t) do o[k]=U.copy(v) end; return o end
function U.shuffle(t,rng) local o=table.clone(t); for i=#o,2,-1 do local j=rng:NextInteger(1,i); o[i],o[j]=o[j],o[i] end; return o end
function U.finite(n) return type(n)==&quot;number&quot; and n==n and math.abs(n)&lt;1e7 end
function U.vector(v) return typeof(v)==&quot;Vector3&quot; and U.finite(v.X) and U.finite(v.Y) and U.finite(v.Z) end
function U.root(m) return m and m:FindFirstChild(&quot;HumanoidRootPart&quot;) end
function U.humanoid(m) return m and m:FindFirstChildOfClass(&quot;Humanoid&quot;) end
function U.contains(t,v) return table.find(t,v)~=nil end
function U.color(a) return Color3.fromRGB(a[1],a[2],a[3]) end
return U
</ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX2149"><Properties><string name="Name">SharedAssets</string></Properties></Item></Item><Item class="ServerScriptService" referent="RBX2168"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX2151"><Properties><string name="Name">Bootstrap</string><ProtectedString name="Source">local Players=game:GetService(&quot;Players&quot;)
local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local Run=game:GetService(&quot;RunService&quot;)
Players.CharacterAutoLoads=false
local shared=RS:WaitForChild(&quot;Shared&quot;)
local C={Config=require(shared.Config),U=require(shared.Utility),Characters=require(shared.CharacterDefinitions),
 Abilities=require(shared.AbilityDefinitions),Modes=require(shared.RoundDefinitions),Maps=require(shared.MapDefinitions),Rng=Random.new(),Remotes={}}
local remotes=RS:FindFirstChild(&quot;Remotes&quot;) or Instance.new(&quot;Folder&quot;); remotes.Name=&quot;Remotes&quot;; remotes.Parent=RS
for _,name in ipairs({&quot;Cast&quot;,&quot;Sprint&quot;,&quot;Action&quot;,&quot;State&quot;,&quot;Vitals&quot;,&quot;Effect&quot;,&quot;Role&quot;,&quot;Results&quot;,&quot;Profile&quot;,&quot;Notice&quot;}) do
 local r=remotes:FindFirstChild(name) or Instance.new(&quot;RemoteEvent&quot;); r.Name=name; r.Parent=remotes; C.Remotes[name]=r
end
for _,name in ipairs({&quot;GameplayEffects&quot;,&quot;SpawnPoints&quot;}) do if not workspace:FindFirstChild(name) then local f=Instance.new(&quot;Folder&quot;); f.Name=name; f.Parent=workspace end end
local services=script.Parent:WaitForChild(&quot;Services&quot;)
local order={&quot;PlayerDataService&quot;,&quot;AntiExploitService&quot;,&quot;RoleService&quot;,&quot;ModeService&quot;,&quot;CombatService&quot;,&quot;DamageService&quot;,&quot;DestructionService&quot;,&quot;MapService&quot;,&quot;NPCService&quot;,&quot;QuestService&quot;,&quot;RewardService&quot;,&quot;RoundService&quot;,&quot;CharacterService&quot;,&quot;AbilityService&quot;,&quot;MonetizationService&quot;}
for _,name in ipairs(order) do C[name]=require(services[name]) end
for _,name in ipairs(order) do C[name]:Init(C) end
local function profile(p) if p.Parent then C.Remotes.Profile:FireClient(p,C.PlayerDataService:Public(p)) end end
local function join(p)
 if #Players:GetPlayers()&gt;C.Config.MaxPlayers then p:Kick(&quot;Сервер заполнен.&quot;); return end
 if not C.PlayerDataService:Load(p) then return end
 if not p.Parent then C.PlayerDataService:Save(p,true); return end
 C.QuestService:Progress(p,&quot;Rounds&quot;,0)
 C.PlayerDataService:Mutate(p,function(d) C.QuestService:Reset(d) end)
 C.CharacterService:Lobby(p); p:SetAttribute(&quot;Ready&quot;,true)
 task.spawn(function() C.MonetizationService:RefreshPasses(p); profile(p) end)
end
Players.PlayerAdded:Connect(function(p) task.spawn(join,p) end)
for _,p in ipairs(Players:GetPlayers()) do task.spawn(join,p) end
Players.PlayerRemoving:Connect(function(p)
 C.CharacterService:Remove(p); C.AntiExploitService:Remove(p); C.MapService.Holds[p]=nil
 C.PlayerDataService:Save(p,true)
end)
C.Remotes.Cast.OnServerEvent:Connect(function(p,id,dir) C.AbilityService:Cast(p,id,dir) end)
C.Remotes.Sprint.OnServerEvent:Connect(function(p,on)
 if type(on)~=&quot;boolean&quot; or not C.AntiExploitService:Allow(p,&quot;Sprint&quot;,5,8) then return end
 local a=C.CharacterService.ByPlayer[p]; if a then a.Sprinting=on end
end)
C.Remotes.Action.OnServerEvent:Connect(function(p,action,arg)
 if type(action)~=&quot;string&quot; or not C.AntiExploitService:Allow(p,&quot;UI&quot;,3,6) then return end
 if not C.PlayerDataService:Get(p) then return end
 if arg~=nil and type(arg)~=&quot;string&quot; and type(arg)~=&quot;boolean&quot; then return end
 if type(arg)==&quot;string&quot; and #arg&gt;80 then return end
 local ok=false
 if action==&quot;Sync&quot; then C.RoundService:Broadcast(); profile(p); return
 elseif action==&quot;Buy&quot; then ok=C.MonetizationService:Purchase(p,arg)
 elseif action==&quot;Equip&quot; then ok=C.MonetizationService:Equip(p,arg)
 elseif action==&quot;Daily&quot; then ok=C.QuestService:Daily(p)
 elseif action==&quot;Quest&quot; then ok=C.QuestService:Claim(p,arg)
 elseif action==&quot;Product&quot; or action==&quot;Pass&quot; then ok=C.MonetizationService:Prompt(p,action,arg)
 elseif action==&quot;Emote&quot; then
  local a=C.CharacterService.ByPlayer[p]; local d=C.PlayerDataService:Get(p)
  if a and a.Alive and not a.Participant and d.Entitlements.Emotes then C.Remotes.Effect:FireAllClients(&quot;Emote&quot;,C.U.root(a.Model).Position,{170,120,255},7,a.Model); ok=true end
 elseif action==&quot;SaveLoadout&quot; or action==&quot;LoadLoadout&quot; then
  local slot=tonumber(arg); local d=C.PlayerDataService:Get(p); local max=d.Entitlements.Loadouts and 3 or 1
  if slot and slot%1==0 and slot&gt;=1 and slot&lt;=max then
   if action==&quot;SaveLoadout&quot; then ok=C.PlayerDataService:Mutate(p,function(data) data.Loadouts[tostring(slot)]=data.EquippedCosmetics end)
   else ok=C.MonetizationService:Equip(p,d.Loadouts[tostring(slot)] or &quot;&quot;) end
  end
 elseif string.sub(action,1,8)==&quot;Setting:&quot; then
  local key=string.sub(action,9)
  if table.find({&quot;LowFX&quot;,&quot;Shake&quot;,&quot;ReducedFlash&quot;,&quot;Scares&quot;,&quot;Sound&quot;},key) and type(arg)==&quot;boolean&quot; then ok=C.PlayerDataService:Mutate(p,function(d) d.Settings[key]=arg end) end
 end
 C.Remotes.Notice:FireClient(p,ok and &quot;Готово&quot; or &quot;Сейчас недоступно или условие не выполнено&quot;)
 profile(p)
end)
local accumulated=0; local net=0; local npc=0
Run.Heartbeat:Connect(function(dt)
 accumulated=accumulated+dt; net=net+dt; npc=npc+dt
 if accumulated&gt;=0.25 then
  local step=math.min(accumulated,0.5); accumulated=0
  C.CharacterService:Step(step); C.MapService:Step(step)
 end
 if npc&gt;=C.Config.NPCThinkSeconds then npc=0; C.NPCService:Step() end
 if net&gt;=0.2 then
  net=0
  for p,a in pairs(C.CharacterService.ByPlayer) do if p.Parent then
   local h=C.U.humanoid(a.Model); local cooldowns={}
   for id,time in pairs(a.Cooldowns) do cooldowns[id]=math.max(0,time-os.clock()) end
   C.Remotes.Vitals:FireClient(p,{HP=h and h.Health or 0,MaxHP=h and h.MaxHealth or 100,Energy=a.Energy,Stamina=a.Stamina,
    Ultimate=a.Ultimate,Alive=a.Alive,Participant=a.Participant,Team=a.Team,Abilities=a.Abilities,UltimateId=a.Definition.UltimateAbility,Cooldowns=cooldowns})
  end end
 end
end)
game:BindToClose(function()
 C.RoundService.Closing=true; C.RoundService.Token=C.RoundService.Token+1; C.PlayerDataService.Closing=true
 local pending=0
 for p in pairs(C.PlayerDataService.Profiles) do pending=pending+1; task.spawn(function() C.PlayerDataService:Save(p,true); pending=pending-1 end) end
 local deadline=os.clock()+25; while pending&gt;0 and os.clock()&lt;deadline do task.wait(0.1) end
end)
C.RoundService:Start()
print(&quot;Cursed Survival&quot;,C.Config.Version,&quot;server ready; persistence:&quot;,C.PlayerDataService.Memory and &quot;MEMORY&quot; or &quot;LIVE&quot;)
</ProtectedString></Properties></Item><Item class="Folder" referent="RBX2167"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX2152"><Properties><string name="Name">AbilityService</string><ProtectedString name="Source">local S={}
function S:Init(ctx) self.C=ctx; self.Tasks={} end
function S:Valid(a,token) return a.Alive and a.Model.Parent and self.C.RoundService.Token==token and self.C.RoundService:IsCombat() end
function S:Cast(p,id,direction)
 local C=self.C
 if type(id)~=&quot;string&quot; or #id&gt;32 or not C.AntiExploitService:Allow(p,&quot;Cast&quot;,7,10) then return end
 local a=C.CharacterService.ByPlayer[p]; local def=C.Abilities[id]
 if not a or not a.Participant or not a.Alive or not C.RoundService:IsCombat() or not def then return end
 if id~=&quot;Basic&quot; and id~=&quot;Heavy&quot; and id~=a.Definition.UltimateAbility and not table.find(a.Abilities,id) then C.AntiExploitService:Flag(p,&quot;ability ownership&quot;); return end
 if not C.U.vector(direction) or direction.Magnitude&lt;0.5 or direction.Magnitude&gt;1.5 then C.AntiExploitService:Flag(p,&quot;invalid aim&quot;); return end
 direction=direction.Unit
 local root=C.U.root(a.Model); if not root then return end
 local now=os.clock()
 if now&lt;a.StunUntil or now&lt;(a.CastUntil or 0) or now&lt;(a.Cooldowns[id] or 0) or a.Energy&lt;def.Cost then return end
 local ultimate=id==a.Definition.UltimateAbility
 if ultimate and a.Ultimate&lt;100 then return end
 -- Reserve resources synchronously, before creating any deferred effect.
 a.Cooldowns[id]=now+def.Cooldown; a.CastUntil=now+math.min(def.Duration,0.45); a.Energy=a.Energy-def.Cost
 if ultimate then a.Ultimate=0 end
 if not a.UsedAbilities[id] then a.UsedAbilities[id]=true; C.QuestService:Progress(p,&quot;Abilities&quot;,1) end
 local token=C.RoundService.Token; local origin=root.Position
 local facing=Vector3.new(direction.X,0,direction.Z)
 if facing.Magnitude&gt;0.05 then root.CFrame=CFrame.lookAt(origin,origin+facing.Unit) end
 C.Remotes.Effect:FireAllClients(&quot;Cast&quot;,origin,def.Color,def.Radius,a.Model,id)
 local function area(center,damage,radius,knock,stun)
  if not self:Valid(a,token) then return end
  C.CombatService:Area(a,center,radius or def.Radius,damage,knock,stun)
 end
 if def.Kind==&quot;Melee&quot; then
  local power=id==&quot;Basic&quot; and a.Definition.AttackPower or def.Damage
  for _,b in ipairs(C.CombatService:Targets(a,def.Range)) do
   local br=C.U.root(b.Model); local v=br.Position-origin
   if v.Magnitude&gt;0 and v.Unit:Dot(direction)&gt;0.25 and C.CombatService:Visible(origin,b,{a.Model}) then C.DamageService:Apply(a,b,power,origin,id==&quot;Heavy&quot; and 45 or 15) end
  end
  C.DestructionService:Blast(origin+direction*5,7,power)
 elseif def.Kind==&quot;Projectile&quot; then
  task.spawn(function()
   local position=origin+direction*3; local traveled=0; local speed=115; local step=0.05
   while self:Valid(a,token) and traveled&lt;def.Range do
    local segment=direction*math.min(speed*step,def.Range-traveled)
    local hit=C.CombatService:Ray(position,segment,{a.Model,workspace.GameplayEffects})
    local nextPos=hit and hit.Position or position+segment
    C.Remotes.Effect:FireAllClients(&quot;Projectile&quot;,nextPos,def.Color,def.Radius,nil,id,position)
    if hit then
     local impact=nextPos-direction*0.35
     area(impact,def.Damage,nil,25,id==&quot;IceSpear&quot; and 1.2 or nil)
     C.DestructionService:Blast(impact,def.Radius,def.Damage); break
    end
    position=nextPos; traveled=traveled+segment.Magnitude; task.wait(step)
   end
  end)
 elseif def.Kind==&quot;Push&quot; or def.Kind==&quot;Pull&quot; or def.Kind==&quot;Stun&quot; then
  local hit=C.CombatService:Ray(origin,direction*def.Range,{a.Model})
  local center=hit and hit.Position-direction*0.5 or origin+direction*math.min(def.Range,20)
  area(center,def.Damage,def.Radius,def.Kind==&quot;Push&quot; and 65 or nil,def.Kind==&quot;Stun&quot; and def.Duration or nil)
  if def.Kind==&quot;Pull&quot; then
   for _,b in ipairs(C.CombatService:Targets(a,def.Range+def.Radius)) do
    local br=C.U.root(b.Model); local delta=center-br.Position
    if delta.Magnitude&lt;def.Radius and delta.Magnitude&gt;1 and C.CombatService:Visible(center,b,{a.Model}) then br.AssemblyLinearVelocity=delta.Unit*48; b.MotionGrace=now+1 end
   end
  end
  C.Remotes.Effect:FireAllClients(&quot;Burst&quot;,center,def.Color,def.Radius)
  C.DestructionService:Blast(center,def.Radius,def.Damage)
 elseif def.Kind==&quot;Shield&quot; then
  a.ShieldUntil=now+def.Duration; a.Model:SetAttribute(&quot;ShieldUntil&quot;,workspace:GetServerTimeNow()+def.Duration)
 elseif def.Kind==&quot;HealSelf&quot; then C.DamageService:Heal(a,a,def.Damage)
 elseif def.Kind==&quot;Heal&quot; then
  for _,b in pairs(C.CharacterService.Actors) do
   local br=C.U.root(b.Model)
   if br and (br.Position-origin).Magnitude&lt;=def.Range and C.CombatService:Visible(origin,b,{a.Model}) then C.DamageService:Heal(a,b,def.Damage) end
  end
 elseif def.Kind==&quot;Teleport&quot; or def.Kind==&quot;Dash&quot; then
  local flat=Vector3.new(direction.X,0,direction.Z); if flat.Magnitude&lt;0.1 then return end; flat=flat.Unit
  -- Blockcast checks character width; ground and arena bounds are independently validated.
  local rp=RaycastParams.new(); rp.FilterType=Enum.RaycastFilterType.Exclude; rp.FilterDescendantsInstances={a.Model,workspace.GameplayEffects}
  local hit=workspace:Blockcast(root.CFrame,Vector3.new(3,4,3),flat*def.Range,rp)
  local length=hit and math.max(0,hit.Distance-2) or def.Range
  local pos=origin+flat*length; local ground=C.CombatService:Ray(pos+Vector3.new(0,3,0),Vector3.new(0,-16,0),{a.Model})
  if ground and math.abs(pos.X)&lt;C.Config.ArenaRadius and math.abs(pos.Z)&lt;C.Config.ArenaRadius then
   pos=Vector3.new(pos.X,ground.Position.Y+3.2,pos.Z)
   root.CFrame=CFrame.lookAt(pos,pos+flat); root.AssemblyLinearVelocity=Vector3.zero; a.MotionGrace=now+1
   if def.Kind==&quot;Dash&quot; then area(pos,def.Damage,nil,35) end
  end
 elseif def.Kind==&quot;Domain&quot; then
  C.Remotes.Effect:FireAllClients(&quot;Domain&quot;,origin,def.Color,def.Radius,a.Model,id)
  task.spawn(function()
   for _=1,math.floor(def.Duration) do
    if not self:Valid(a,token) then break end
    area(origin,def.Damage,nil,nil,id==&quot;UnlimitedVoid&quot; and 0.65 or nil)
    C.DestructionService:Blast(origin,def.Radius,20); task.wait(1)
   end
  end)
 elseif def.Kind==&quot;Trap&quot; then
  local hit=C.CombatService:Ray(origin,direction*def.Range,{a.Model})
  local center=hit and hit.Position-direction or origin+direction*def.Range
  local ground=C.CombatService:Ray(center+Vector3.new(0,6,0),Vector3.new(0,-30,0),{a.Model})
  if ground then center=ground.Position+Vector3.new(0,0.3,0) end
  C.Remotes.Effect:FireAllClients(&quot;Trap&quot;,center,def.Color,def.Radius,nil,id,def.Duration)
  task.spawn(function()
   local finish=os.clock()+def.Duration
   while self:Valid(a,token) and os.clock()&lt;finish do
    if C.CombatService:Area(a,center+Vector3.new(0,2,0),def.Radius,def.Damage,0,2)&gt;0 then break end
    task.wait(0.25)
   end
  end)
 elseif def.Kind==&quot;Summon&quot; then C.NPCService:Summon(a,def,token) end
end
return S
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2153"><Properties><string name="Name">AntiExploitService</string><ProtectedString name="Source">local S={}
function S:Init(ctx) self.C=ctx; self.Buckets={}; self.Log={}; self.Motion={}; self.Audit={} end
function S:Flag(p,reason)
 local now=os.clock(); local key=p.UserId..&quot;:&quot;..reason
 if self.Log[key] and now-self.Log[key]&lt;10 then return end
 self.Log[key]=now; warn(&quot;[Guard]&quot;,p.UserId,reason)
 if #self.Audit&gt;=100 then table.remove(self.Audit,1) end
 table.insert(self.Audit,{User=p.UserId,Reason=reason,Time=os.time()})
end
function S:Allow(p,channel,rate,burst)
 self.Audit=self.Audit or {}
 local key=p.UserId..&quot;:&quot;..channel; local now=os.clock(); local b=self.Buckets[key] or {At=now,Tokens=burst}
 b.Tokens=math.min(burst,b.Tokens+(now-b.At)*rate); b.At=now; self.Buckets[key]=b
 if b.Tokens&lt;1 then self:Flag(p,&quot;rate:&quot;..channel); return false end
 b.Tokens=b.Tokens-1; return true
end
function S:Step(a,dt)
 if not a.Player or not a.Alive then return end
 local root=self.C.U.root(a.Model); if not root then return end
 local now=os.clock(); local pos=root.Position
 if not self.C.U.vector(pos) then a.Alive=false; a.Model:Destroy(); return end
 local old=self.Motion[a.Player]
 if old and now&gt;(a.MotionGrace or 0) then
  local delta=Vector3.new(pos.X-old.Pos.X,0,pos.Z-old.Pos.Z).Magnitude
  if delta&gt;math.max(18,(a.Definition.SprintSpeed+12)*dt*2.5) then
   root.CFrame=CFrame.new(old.Pos); root.AssemblyLinearVelocity=Vector3.zero
   self:Flag(a.Player,&quot;movement&quot;); return
  end
 end
 self.Motion[a.Player]={Pos=pos}
end
function S:Remove(p)
 self.Motion[p]=nil
 for k in pairs(self.Buckets) do if string.sub(k,1,#tostring(p.UserId)+1)==p.UserId..&quot;:&quot; then self.Buckets[k]=nil end end
 for k in pairs(self.Log) do if string.sub(k,1,#tostring(p.UserId)+1)==p.UserId..&quot;:&quot; then self.Log[k]=nil end end
end
return S
