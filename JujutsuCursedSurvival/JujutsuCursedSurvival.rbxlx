or3><CoordinateFrame name="CFrame"><X>-97.00735091368509</X><Y>0.5</Y><Z>-40.18176039833448</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4282502655</Color3uint8><token name="Material">256</token><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CanQuery">false</bool><float name="Transparency">1</float><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties></Item><Item class="Part" referent="RBX1366"><Properties><string name="Name">Spawn12</string><Vector3 name="size"><X>3</X><Y>0.2</Y><Z>3</Z></Vector3><CoordinateFrame name="CFrame"><X>-105</X><Y>0.5</Y><Z>-1.928818708657081e-14</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4282502655</Color3uint8><token name="Material">256</token><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CanQuery">false</bool><float name="Transparency">1</float><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties></Item><Item class="Part" referent="RBX1367"><Properties><string name="Name">Spawn13</string><Vector3 name="size"><X>3</X><Y>0.2</Y><Z>3</Z></Vector3><CoordinateFrame name="CFrame"><X>-97.0073509136851</X><Y>0.5</Y><Z>40.18176039833445</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4282502655</Color3uint8><token name="Material">256</token><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CanQuery">false</bool><float name="Transparency">1</float><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties></Item><Item class="Part" referent="RBX1368"><Properties><string name="Name">Spawn14</string><Vector3 name="size"><X>3</X><Y>0.2</Y><Z>3</Z></Vector3><CoordinateFrame name="CFrame"><X>-74.2462120245875</X><Y>0.5</Y><Z>74.24621202458748</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4282502655</Color3uint8><token name="Material">256</token><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CanQuery">false</bool><float name="Transparency">1</float><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties></Item><Item class="Part" referent="RBX1369"><Properties><string name="Name">Spawn15</string><Vector3 name="size"><X>3</X><Y>0.2</Y><Z>3</Z></Vector3><CoordinateFrame name="CFrame"><X>-40.18176039833449</X><Y>0.5</Y><Z>97.00735091368509</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4282502655</Color3uint8><token name="Material">256</token><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CanQuery">false</bool><float name="Transparency">1</float><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties></Item></Item><Item class="Folder" referent="RBX1348"><Properties><string name="Name">Pickups</string></Properties><Item class="Part" referent="RBX1481"><Properties><string name="Name">EnergyShard</string><Vector3 name="size"><X>1.4</X><Y>2.4</Y><Z>1.4</Z></Vector3><CoordinateFrame name="CFrame"><X>-30</X><Y>2</Y><Z>-35</Z><R00>0.8253356149096783</R00><R01>0</R01><R02>0.5646424733950354</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>-0.5646424733950354</R20><R21>0</R21><R22>0.8253356149096783</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4282502655</Color3uint8><token name="Material">288</token><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><bool name="CanTouch">false</bool><bool name="CanQuery">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties></Item><Item class="Part" referent="RBX1482"><Properties><string name="Name">EnergyShard</string><Vector3 name="size"><X>1.4</X><Y>2.4</Y><Z>1.4</Z></Vector3><CoordinateFrame name="CFrame"><X>30</X><Y>2</Y><Z>35</Z><R00>0.8253356149096783</R00><R01>0</R01><R02>0.5646424733950354</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>-0.5646424733950354</R20><R21>0</R21><R22>0.8253356149096783</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4282502655</Color3uint8><token name="Material">288</token><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><bool name="CanTouch">false</bool><bool name="CanQuery">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties></Item><Item class="Part" referent="RBX1483"><Properties><string name="Name">EnergyShard</string><Vector3 name="size"><X>1.4</X><Y>2.4</Y><Z>1.4</Z></Vector3><CoordinateFrame name="CFrame"><X>-95</X><Y>2</Y><Z>65</Z><R00>0.8253356149096783</R00><R01>0</R01><R02>0.5646424733950354</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>-0.5646424733950354</R20><R21>0</R21><R22>0.8253356149096783</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4282502655</Color3uint8><token name="Material">288</token><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><bool name="CanTouch">false</bool><bool name="CanQuery">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties></Item><Item class="Part" referent="RBX1484"><Properties><string name="Name">EnergyShard</string><Vector3 name="size"><X>1.4</X><Y>2.4</Y><Z>1.4</Z></Vector3><CoordinateFrame name="CFrame"><X>95</X><Y>2</Y><Z>-65</Z><R00>0.8253356149096783</R00><R01>0</R01><R02>0.5646424733950354</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>-0.5646424733950354</R20><R21>0</R21><R22>0.8253356149096783</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4282502655</Color3uint8><token name="Material">288</token><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><bool name="CanTouch">false</bool><bool name="CanQuery">true</bool><float name="Transparency">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token></Properties></Item></Item></Item></Item><Item class="Folder" referent="RBX2170"><Properties><string name="Name">NPCs</string></Properties></Item><Item class="Folder" referent="RBX2171"><Properties><string name="Name">ServerAssets</string></Properties></Item></Item><Item class="StarterPlayer" referent="RBX2182"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX2181"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="ModuleScript" referent="RBX2173"><Properties><string name="Name">CameraController</string><ProtectedString name="Source">local Tween=game:GetService(&quot;TweenService&quot;)
local Run=game:GetService(&quot;RunService&quot;)
local S={}
function S:Init(ctx) self.C=ctx; self.Serial=0; self.ShakeUntil=0
 Run:BindToRenderStep(&quot;CursedCamera&quot;,Enum.RenderPriority.Camera.Value+1,function()
  local camera=workspace.CurrentCamera
  if ctx.Settings.Shake and not ctx.Settings.ReducedFlash and os.clock()&lt;self.ShakeUntil then
   local amount=0.06*(self.ShakeUntil-os.clock())/0.2
   camera.CFrame=camera.CFrame*CFrame.new(math.sin(os.clock()*91)*amount,math.cos(os.clock()*73)*amount,0)
  end
 end)
end
function S:Intro()
 local C=self.C; local root=C.U.root(C.Player.Character); if not root then return end
 self.Serial=self.Serial+1; local serial=self.Serial; local camera=workspace.CurrentCamera
 camera.CameraType=Enum.CameraType.Scriptable
 camera.CFrame=CFrame.lookAt(root.Position+root.CFrame.LookVector*13+Vector3.new(5,5,0),root.Position)
 Tween:Create(camera,TweenInfo.new(1.6,Enum.EasingStyle.Sine),{CFrame=CFrame.lookAt(root.Position+root.CFrame.LookVector*8+Vector3.new(-3,2,0),root.Position+Vector3.new(0,1,0))}):Play()
 task.delay(1.7,function() if serial==self.Serial then camera.CameraType=Enum.CameraType.Custom; camera.CameraSubject=C.U.humanoid(C.Player.Character) end end)
end
function S:Effect(kind,pos,model)
 local C=self.C; local root=C.U.root(C.Player.Character); if not root then return end
 local distance=(root.Position-pos).Magnitude
 if kind==&quot;Hit&quot; and distance&lt;15 then self.ShakeUntil=os.clock()+0.2 end
 if kind==&quot;Domain&quot; and distance&lt;70 and not C.Settings.ReducedFlash then
  local cam=workspace.CurrentCamera; Tween:Create(cam,TweenInfo.new(0.25),{FieldOfView=80}):Play()
  task.delay(0.7,function() Tween:Create(cam,TweenInfo.new(0.6),{FieldOfView=70}):Play() end)
 end
 if kind==&quot;Scare&quot; and C.Settings.Scares then C.UIController:Notice(&quot;РАЗЛОМ ОТКРЫТ • ПРОКЛЯТИЕ ПРОБУДИЛОСЬ&quot;) end
end
return S
</ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX2174"><Properties><string name="Name">ClientBootstrap</string><ProtectedString name="Source">local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local Players=game:GetService(&quot;Players&quot;)
local shared=RS:WaitForChild(&quot;Shared&quot;)
local C={Player=Players.LocalPlayer,Config=require(shared.Config),Abilities=require(shared.AbilityDefinitions),
 Characters=require(shared.CharacterDefinitions),U=require(shared.Utility),Remotes={},Settings={LowFX=false,Shake=true,ReducedFlash=false,Scares=true,Sound=true}}
local folder=RS:WaitForChild(&quot;Remotes&quot;)
for _,name in ipairs({&quot;Cast&quot;,&quot;Sprint&quot;,&quot;Action&quot;,&quot;State&quot;,&quot;Vitals&quot;,&quot;Effect&quot;,&quot;Role&quot;,&quot;Results&quot;,&quot;Profile&quot;,&quot;Notice&quot;}) do C.Remotes[name]=folder:WaitForChild(name) end
local names={&quot;SoundController&quot;,&quot;VFXController&quot;,&quot;CameraController&quot;,&quot;SpectatorController&quot;,&quot;UIController&quot;,&quot;CombatController&quot;,&quot;InputController&quot;}
for _,name in ipairs(names) do C[name]=require(script.Parent[name]) end
for _,name in ipairs(names) do C[name]:Init(C) end
C.Remotes.State.OnClientEvent:Connect(function(s) C.State=s; C.UIController:State(s); C.SpectatorController:Update() end)
C.Remotes.Vitals.OnClientEvent:Connect(function(v) C.Vitals=v; C.UIController:Vitals(v) end)
C.Remotes.Profile.OnClientEvent:Connect(function(d)
 if not d then return end
 C.Profile=d; for k,v in pairs(d.Settings or {}) do C.Settings[k]=v end
 C.UIController:Profile(d); C.VFXController:ApplyQuality()
end)
C.Remotes.Role.OnClientEvent:Connect(function(r) C.UIController:Role(r); C.CameraController:Intro() end)
C.Remotes.Results.OnClientEvent:Connect(function(r) C.UIController:Results(r) end)
C.Remotes.Notice.OnClientEvent:Connect(function(t) C.UIController:Notice(t) end)
C.Remotes.Effect.OnClientEvent:Connect(function(kind,pos,color,radius,model,id,extra)
 C.VFXController:Effect(kind,pos,color,radius,model,id,extra)
 C.SoundController:Play(id or kind,pos)
 C.CameraController:Effect(kind,pos,model)
 C.CombatController:Animate(kind,model,id)
end)
C.Player.CharacterAdded:Connect(function(char)
 local h=char:WaitForChild(&quot;Humanoid&quot;,10); if h then workspace.CurrentCamera.CameraSubject=h; workspace.CurrentCamera.CameraType=Enum.CameraType.Custom end
end)
task.spawn(function()
 for _=1,6 do C.Remotes.Action:FireServer(&quot;Sync&quot;); task.wait(3); if C.Profile then break end end
end)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2175"><Properties><string name="Name">CombatController</string><ProtectedString name="Source">local Run=game:GetService(&quot;RunService&quot;)
local S={}
function S:Init(ctx)
 self.C=ctx; self.Poses=setmetatable({},{__mode=&quot;k&quot;}); self.Rigs=setmetatable({},{__mode=&quot;k&quot;}); self.Scan=0
 -- Procedural R15 locomotion and combat; no unpublished AnimationId is represented as working.
 Run.PreSimulation:Connect(function(dt)
  self.Scan=self.Scan+dt
  if self.Scan&gt;1 then
   self.Scan=0
   for _,m in ipairs(workspace:GetChildren()) do if m:IsA(&quot;Model&quot;) and m:FindFirstChildOfClass(&quot;Humanoid&quot;) and not self.Rigs[m] then
    local joints={}; for _,v in ipairs(m:GetDescendants()) do if v:IsA(&quot;Motor6D&quot;) then joints[v.Name]=v end end
    self.Rigs[m]=joints
   end end
  end
  for m,joints in pairs(self.Rigs) do
   if not m.Parent then self.Rigs[m]=nil else
    local h=ctx.U.humanoid(m); local root=ctx.U.root(m)
    if h and root then
     local speed=Vector3.new(root.AssemblyLinearVelocity.X,0,root.AssemblyLinearVelocity.Z).Magnitude
     local t=os.clock(); local stride=math.sin(t*(speed&gt;20 and 15 or 10))*math.min(speed/22,1)*0.65
     local pose=self.Poses[m]; local cast=pose and t&lt;pose.Until; local dead=h.Health&lt;=0
     local air=h.FloorMaterial==Enum.Material.Air; local attack=cast and (pose.Kind==&quot;Hit&quot; and -0.35 or -1.8) or 0
     local transforms={LeftShoulder=CFrame.Angles(air and -0.5 or stride,0,-0.08),
      RightShoulder=CFrame.Angles(cast and attack or (air and -0.5 or -stride),0,cast and -0.4 or 0.08),
      LeftHip=CFrame.Angles(air and -0.25 or -stride,0,0),RightHip=CFrame.Angles(air and 0.2 or stride,0,0),
      Waist=CFrame.Angles(dead and -0.9 or (cast and -0.12 or math.sin(t*2)*0.025),0,0),
      Neck=CFrame.Angles(dead and 0.5 or 0,0,0)}
     if cast and pose.Kind==&quot;Emote&quot; then transforms.RightShoulder=CFrame.Angles(-2.8,0,math.sin(t*10)*0.3) end
     for name,cf in pairs(transforms) do if joints[name] then joints[name].Transform=cf end end
    end
   end
  end
 end)
end
function S:Animate(kind,model,id)
 if model and (kind==&quot;Cast&quot; or kind==&quot;Hit&quot; or kind==&quot;Domain&quot; or kind==&quot;Emote&quot;) then
  self.Poses[model]={Kind=kind,Id=id,Until=os.clock()+(kind==&quot;Domain&quot; and 1.2 or kind==&quot;Emote&quot; and 2 or 0.35)}
 end
end
return S
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2176"><Properties><string name="Name">InputController</string><ProtectedString name="Source">local CAS=game:GetService(&quot;ContextActionService&quot;)
local UIS=game:GetService(&quot;UserInputService&quot;)
local S={}
function S:Init(ctx)
 self.C=ctx
 local function cast(index)
  if UIS:GetFocusedTextBox() or ctx.UIController.Modal.Visible then return end
  self:Cast(index)
 end
 local keys={Enum.KeyCode.Q,Enum.KeyCode.E,Enum.KeyCode.R,Enum.KeyCode.F,Enum.KeyCode.T}
 for i,key in ipairs(keys) do CAS:BindAction(&quot;Technique&quot;..i,function(_,state) if state==Enum.UserInputState.Begin then cast(i) end; return Enum.ContextActionResult.Sink end,false,key) end
 CAS:BindAction(&quot;Basic&quot;,function(_,state) if state==Enum.UserInputState.Begin then cast(&quot;Basic&quot;) end; return Enum.ContextActionResult.Pass end,false,Enum.UserInputType.MouseButton1,Enum.KeyCode.ButtonR2)
 CAS:BindAction(&quot;Heavy&quot;,function(_,state) if state==Enum.UserInputState.Begin then cast(&quot;Heavy&quot;) end; return Enum.ContextActionResult.Sink end,false,Enum.KeyCode.X)
 CAS:BindAction(&quot;Ultimate&quot;,function(_,state) if state==Enum.UserInputState.Begin then cast(&quot;Ultimate&quot;) end; return Enum.ContextActionResult.Sink end,false,Enum.KeyCode.G)
 CAS:BindAction(&quot;Sprint&quot;,function(_,state) ctx.Remotes.Sprint:FireServer(state==Enum.UserInputState.Begin); return Enum.ContextActionResult.Sink end,false,Enum.KeyCode.LeftShift,Enum.KeyCode.ButtonL3)
end
function S:Cast(index)
 local C=self.C; local v=C.Vitals; if not v or not v.Alive or not v.Participant then return end
 local id=type(index)==&quot;number&quot; and v.Abilities[index] or index
 if id==&quot;Ultimate&quot; then id=v.UltimateId end; if not id then return end
 local camera=workspace.CurrentCamera; local point=UIS.TouchEnabled and camera.ViewportSize/2 or UIS:GetMouseLocation()
 local ray=UIS.TouchEnabled and camera:ViewportPointToRay(point.X,point.Y) or camera:ScreenPointToRay(point.X,point.Y)
 local rp=RaycastParams.new(); rp.FilterType=Enum.RaycastFilterType.Exclude; rp.FilterDescendantsInstances={C.Player.Character,workspace.GameplayEffects}
 local hit=workspace:Raycast(ray.Origin,ray.Direction*300,rp)
 local target=hit and hit.Position or ray.Origin+ray.Direction*160
 local root=C.U.root(C.Player.Character); if not root then return end
 local delta=target-root.Position; if delta.Magnitude&lt;0.1 then return end
 C.Remotes.Cast:FireServer(id,delta.Unit)
end
return S
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2177"><Properties><string name="Name">SoundController</string><ProtectedString name="Source">local Content=game:GetService(&quot;ContentProvider&quot;)
local Debris=game:GetService(&quot;Debris&quot;)
local S={}
function S:Init(ctx)
 self.C=ctx; self.Active=0
 local ids={}; for _,id in pairs(ctx.Config.Sounds) do if type(id)==&quot;string&quot; and id~=&quot;&quot; then table.insert(ids,id) end end
 if #ids&gt;0 then task.spawn(function() pcall(function() Content:PreloadAsync(ids) end) end) end
end
function S:Play(id,pos)
 local C=self.C; local asset=C.Config.Sounds[id]
 if not C.Settings.Sound or not asset or self.Active&gt;=12 then return end
 local camera=workspace.CurrentCamera; if (camera.CFrame.Position-pos).Magnitude&gt;160 then return end
 local p=Instance.new(&quot;Part&quot;); p.Anchored=true; p.Transparency=1; p.CanCollide=false; p.CanQuery=false; p.CanTouch=false; p.Position=pos; p.Parent=workspace.GameplayEffects
 local sound=Instance.new(&quot;Sound&quot;); sound.SoundId=asset; sound.Volume=0.35; sound.RollOffMaxDistance=130; sound.Parent=p
 self.Active=self.Active+1; sound:Play(); Debris:AddItem(p,5)
 task.delay(5,function() self.Active=math.max(0,self.Active-1) end)
end
return S
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2178"><Properties><string name="Name">SpectatorController</string><ProtectedString name="Source">local Players=game:GetService(&quot;Players&quot;)
local S={}
function S:Init(ctx) self.C=ctx; self.Index=0
 ctx.Player:GetAttributeChangedSignal(&quot;Spectator&quot;):Connect(function() self:Update() end)
end
function S:Update()
 local C=self.C; local enabled=C.Player:GetAttribute(&quot;Spectator&quot;) and C.State and (C.State.State==&quot;InProgress&quot; or C.State.State==&quot;SuddenDeath&quot;)
 if C.UIController.Spectate then C.UIController.Spectate.Visible=enabled==true end
 if not enabled then
  local h=C.U.humanoid(C.Player.Character); if h then workspace.CurrentCamera.CameraSubject=h end
 end
end
function S:Next()
 local list={}
 for _,p in ipairs(Players:GetPlayers()) do
  local char=p.Character; local h=self.C.U.humanoid(char)
  if p~=self.C.Player and char and char:GetAttribute(&quot;Participant&quot;) and h and h.Health&gt;0 then table.insert(list,p) end
 end
 table.sort(list,function(a,b) return a.UserId&lt;b.UserId end)
 if #list==0 then self.C.UIController:Notice(&quot;Нет доступных участников&quot;); return end
 self.Index=self.Index%#list+1; local p=list[self.Index]; workspace.CurrentCamera.CameraType=Enum.CameraType.Custom
 workspace.CurrentCamera.CameraSubject=self.C.U.humanoid(p.Character); self.C.UIController:Notice(&quot;Наблюдение: &quot;..p.DisplayName)
end
return S
